    "cc_intro": {
      "type": "custom-code",
      "settings": {
        "show_on_display": "desktop_and_mobile",
        "custom_liquid": "<div class=\"vllc-pr-head\">\n  <p class=\"vllc-pr-eyebrow\">Notre promesse</p>\n  <h1 class=\"vllc-pr-h1\">Un instrument, on l'achète une fois.<br>On n'a pas le droit de se tromper.</h1>\n  <p class=\"vllc-pr-lead\">Il restera posé dans votre salon pendant des années. Vous le prendrez le soir sans y penser, vous le tendrez à quelqu'un qui n'a jamais joué. C'est pour cette raison que nous prenons autant de précautions avant qu'il n'entre au catalogue — et que nous restons joignables longtemps après qu'il soit chez vous.</p>\n  <p class=\"vllc-pr-lead vllc-pr-lead--last\">Voici, précisément, ce à quoi nous nous engageons.</p>\n</div>\n<style>\n.vllc-pr-head{max-width:900px;margin:0 auto;padding:74px 24px 4px;text-align:center}\n.vllc-pr-eyebrow{text-transform:uppercase;letter-spacing:2.4px;font-size:11.5px;font-weight:600;color:#B98A2E;margin:0 0 16px}\n.vllc-pr-h1{font-family:Georgia,'Times New Roman',serif;font-weight:400;font-size:47px;line-height:1.16;letter-spacing:-.4px;color:#22332A;margin:0 0 22px}\n.vllc-pr-lead{font-size:17px;line-height:1.78;color:#5A6B60;margin:0 auto 14px;max-width:680px}\n.vllc-pr-lead--last{color:#22332A;font-style:italic;margin-bottom:0}\n@media(max-width:600px){.vllc-pr-h1{font-size:30px}.vllc-pr-head{padding-top:52px}.vllc-pr-lead{font-size:15.5px}}\n</style>",
        "margin_top": 0,
        "margin_bottom": 0,
        "additional_class": ""
      },
      "disabled": true
    },
    "title_premium": {
