{% comment %}
  sections/newsletter-velluce.liquid
  Newsletter Velluce - bloc d'inscription premium (accueil / pages / fiches produit).
{% endcomment %}

{%- liquid
  assign nl_id = section.id
  assign nl_form_id = 'newsletter-velluce-' | append: section.id
  assign nl_max = section.settings.max_width | default: 1400 | at_least: 1200
-%}

<section
  class="nlb"
  id="nlb-{{ nl_id }}"
  style="--nlb-beige: {{ section.settings.color_beige }};
         --nlb-accent: {{ section.settings.color_accent }};
         --nlb-ink: {{ section.settings.color_ink }};
         --nlb-soft: {{ section.settings.color_soft }};"
>
  <div class="nlb__wrap">
    <div class="nlb__card">

      <span class="nlb__blob nlb__blob--a" aria-hidden="true"></span>
      <span class="nlb__blob nlb__blob--b" aria-hidden="true"></span>

      <div class="nlb__grid">

        <div class="nlb__left">
          {%- if section.settings.eyebrow != blank -%}
            <span class="nlb__eyebrow">
              <span class="nlb__dot" aria-hidden="true"></span>
              {{ section.settings.eyebrow }}
            </span>
          {%- endif -%}

          {%- if section.settings.title != blank -%}
            <h2 class="nlb__title">{{ section.settings.title }}</h2>
          {%- endif -%}

          {%- if section.settings.subtitle != blank -%}
            <p class="nlb__subtitle">{{ section.settings.subtitle }}</p>
          {%- endif -%}

          {%- if section.blocks.size > 0 -%}
            <ul class="nlb__benefits">
              {%- for block in section.blocks -%}
                {%- if block.type == 'benefit' -%}
                  <li class="nlb__benefit" {{ block.shopify_attributes }}>
                    <span class="nlb__check" aria-hidden="true">
                      <svg viewBox="0 0 20 20" width="12" height="12" fill="none">
                        <path d="M4 10.5L8 14.5L16 5.5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                    <span class="nlb__benefit-txt">
                      <strong>{{ block.settings.title }}</strong>
                      {%- if block.settings.text != blank -%}
                        <span>{{ block.settings.text }}</span>
                      {%- endif -%}
                    </span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>

        <div class="nlb__right">
          <div class="nlb__form-card">

            {%- if section.settings.form_heading != blank -%}
              <p class="nlb__form-heading">{{ section.settings.form_heading }}</p>
            {%- endif -%}

            {%- form 'customer', id: nl_form_id, class: 'nlb__form' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">

              {%- if form.posted_successfully? -%}
                <div class="nlb__success" role="status">
                  <span class="nlb__success-icon" aria-hidden="true">
                    <svg viewBox="0 0 20 20" width="16" height="16" fill="none">
                      <path d="M4 10.5L8 14.5L16 5.5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                  <span>{{ section.settings.success_message }}</span>
                </div>
              {%- else -%}

                {%- if form.errors -%}
                  <div class="nlb__error" role="alert">
                    {{ form.errors | default_errors }}
                  </div>
                {%- endif -%}

                <div class="nlb__field">
                  <label class="nlb__label" for="nlb-email-{{ nl_id }}">
                    {{ section.settings.label_email }}
                  </label>
                  <div class="nlb__row">
                    <span class="nlb__input-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="17" height="17" fill="none">
                        <rect x="3" y="5.5" width="18" height="13" rx="2.5" stroke="currentColor" stroke-width="1.6"/>
                        <path d="M4 7.5L12 13L20 7.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                    <input
                      type="email"
                      name="contact[email]"
                      id="nlb-email-{{ nl_id }}"
                      class="nlb__input"
                      placeholder="{{ section.settings.email_placeholder }}"
                      autocomplete="email"
                      required
                      aria-label="{{ section.settings.label_email }}"
                    >
                    <button type="submit" class="nlb__btn">
                      <span>{{ section.settings.button_label }}</span>
                      <svg viewBox="0 0 24 24" width="15" height="15" fill="none" aria-hidden="true">
                        <path d="M5 12H19M19 12L13 6M19 12L13 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </button>
                  </div>
                </div>

                {%- if section.settings.legal_text != blank -%}
                  <p class="nlb__legal">{{ section.settings.legal_text }}</p>
                {%- endif -%}

              {%- endif -%}
            {%- endform -%}

            {%- if section.settings.reassurance != blank -%}
              <p class="nlb__reassurance">
                <span class="nlb__lock" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="13" height="13" fill="none">
                    <rect x="5" y="10.5" width="14" height="9.5" rx="2" stroke="currentColor" stroke-width="1.7"/>
                    <path d="M8.2 10.5V7.8a3.8 3.8 0 017.6 0v2.7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                  </svg>
                </span>
                {{ section.settings.reassurance }}
              </p>
            {%- endif -%}

          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<style>
  #nlb-{{ nl_id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: #ffffff;
    box-sizing: border-box;
  }

  #nlb-{{ nl_id }} * { box-sizing: border-box; }

  #nlb-{{ nl_id }} .nlb__wrap {
    max-width: {{ nl_max }}px;
    margin: 0 auto;
    padding: 0 40px;
  }

  #nlb-{{ nl_id }} .nlb__card {
    position: relative;
    overflow: hidden;
    border-radius: 28px;
    padding: 56px 60px;
    background:
      radial-gradient(120% 140% at 100% 0%, rgba(255, 255, 255, 0.55) 0%, rgba(255, 255, 255, 0) 55%),
      linear-gradient(135deg, var(--nlb-soft) 0%, var(--nlb-beige) 100%);
    border: 1px solid rgba(41, 47, 44, 0.06);
  }

  /* Formes douces en arriere-plan : donne du relief sans surcharger. */
  #nlb-{{ nl_id }} .nlb__blob {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }
  #nlb-{{ nl_id }} .nlb__blob--a {
    width: 340px; height: 340px;
    right: -90px; top: -140px;
    background: radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.75), rgba(255, 255, 255, 0) 70%);
  }
  #nlb-{{ nl_id }} .nlb__blob--b {
    width: 260px; height: 260px;
    left: -110px; bottom: -130px;
    background: radial-gradient(circle at 60% 40%, rgba(149, 178, 164, 0.28), rgba(149, 178, 164, 0) 70%);
  }

  #nlb-{{ nl_id }} .nlb__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 48px;
    align-items: center;
  }

  /* ---------- colonne gauche ---------- */

  #nlb-{{ nl_id }} .nlb__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.72);
    color: var(--nlb-ink);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    padding: 8px 15px;
    border-radius: 999px;
    margin-bottom: 20px;
    border: 1px solid rgba(41, 47, 44, 0.07);
  }

  #nlb-{{ nl_id }} .nlb__dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--nlb-accent);
    display: inline-block;
  }

  #nlb-{{ nl_id }} .nlb__title {
    color: var(--nlb-ink);
    font-size: 40px;
    line-height: 1.14;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 14px 0;
  }

  #nlb-{{ nl_id }} .nlb__subtitle {
    color: rgba(41, 47, 44, 0.72);
    font-size: 16px;
    line-height: 1.6;
    margin: 0;
    max-width: 46ch;
  }

  #nlb-{{ nl_id }} .nlb__benefits {
    list-style: none;
    margin: 26px 0 0 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }

  #nlb-{{ nl_id }} .nlb__benefit {
    display: flex;
    align-items: flex-start;
    gap: 11px;
  }

  #nlb-{{ nl_id }} .nlb__check {
    flex: 0 0 auto;
    width: 22px; height: 22px;
    border-radius: 50%;
    background: #ffffff;
    color: var(--nlb-accent);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 1px;
    box-shadow: 0 1px 3px rgba(41, 47, 44, 0.08);
  }

  #nlb-{{ nl_id }} .nlb__benefit-txt {
    display: block;
    font-size: 14.5px;
    line-height: 1.5;
    color: rgba(41, 47, 44, 0.72);
  }

  #nlb-{{ nl_id }} .nlb__benefit-txt strong {
    color: var(--nlb-ink);
    font-weight: 650;
  }

  #nlb-{{ nl_id }} .nlb__benefit-txt span {
    display: block;
  }

  /* ---------- colonne droite : la carte formulaire ---------- */

  #nlb-{{ nl_id }} .nlb__form-card {
    background: #ffffff;
    border-radius: 20px;
    padding: 30px 30px 26px;
    box-shadow: 0 18px 44px rgba(41, 47, 44, 0.10);
    border: 1px solid rgba(41, 47, 44, 0.05);
  }

  #nlb-{{ nl_id }} .nlb__form-heading {
    margin: 0 0 18px 0;
    font-size: 17px;
    font-weight: 700;
    color: var(--nlb-ink);
    letter-spacing: -0.01em;
  }

  #nlb-{{ nl_id }} .nlb__form { margin: 0; }

  #nlb-{{ nl_id }} .nlb__label {
    display: block;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgba(41, 47, 44, 0.55);
    margin-bottom: 8px;
  }

  #nlb-{{ nl_id }} .nlb__row {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--nlb-soft);
    border: 1.5px solid rgba(41, 47, 44, 0.10);
    border-radius: 14px;
    padding: 6px 6px 6px 14px;
    transition: border-color 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
  }

  #nlb-{{ nl_id }} .nlb__row:focus-within {
    border-color: var(--nlb-accent);
    background: #ffffff;
    box-shadow: 0 0 0 4px rgba(149, 178, 164, 0.16);
  }

  #nlb-{{ nl_id }} .nlb__input-icon {
    flex: 0 0 auto;
    color: rgba(41, 47, 44, 0.38);
    display: inline-flex;
    align-items: center;
  }

  #nlb-{{ nl_id }} .nlb__input {
    flex: 1 1 auto;
    min-width: 0;
    border: none;
    background: transparent;
    outline: none;
    font-family: inherit;
    font-size: 15.5px;
    color: var(--nlb-ink);
    padding: 12px 2px;
  }

  #nlb-{{ nl_id }} .nlb__input::placeholder { color: rgba(41, 47, 44, 0.38); }

  #nlb-{{ nl_id }} .nlb__btn {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: none;
    cursor: pointer;
    font-family: inherit;
    font-size: 14.5px;
    font-weight: 650;
    color: #ffffff;
    background: var(--nlb-ink);
    border-radius: 11px;
    padding: 13px 20px;
    line-height: 1;
    transition: background 0.18s ease, transform 0.18s ease;
    white-space: nowrap;
  }

  #nlb-{{ nl_id }} .nlb__btn:hover {
    background: var(--nlb-accent);
    transform: translateY(-1px);
  }

  #nlb-{{ nl_id }} .nlb__btn svg { transition: transform 0.18s ease; }
  #nlb-{{ nl_id }} .nlb__btn:hover svg { transform: translateX(3px); }

  #nlb-{{ nl_id }} .nlb__legal {
    margin: 12px 2px 0;
    font-size: 12.5px;
    line-height: 1.5;
    color: rgba(41, 47, 44, 0.5);
  }

  #nlb-{{ nl_id }} .nlb__reassurance {
    display: flex;
    align-items: center;
    gap: 7px;
    margin: 18px 0 0 0;
    padding-top: 16px;
    border-top: 1px solid rgba(41, 47, 44, 0.08);
    font-size: 12.5px;
    color: rgba(41, 47, 44, 0.55);
  }

  #nlb-{{ nl_id }} .nlb__lock {
    display: inline-flex;
    color: var(--nlb-accent);
  }

  #nlb-{{ nl_id }} .nlb__success {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    background: var(--nlb-soft);
    border: 1px solid rgba(149, 178, 164, 0.35);
    border-radius: 14px;
    padding: 16px 18px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--nlb-ink);
  }

  #nlb-{{ nl_id }} .nlb__success-icon {
    flex: 0 0 auto;
    width: 22px; height: 22px;
    border-radius: 50%;
    background: var(--nlb-accent);
    color: #ffffff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 1px;
  }

  #nlb-{{ nl_id }} .nlb__error {
    background: #fdf1f1;
    border: 1px solid rgba(163, 44, 44, 0.25);
    color: #8f2626;
    border-radius: 12px;
    padding: 11px 14px;
    font-size: 13px;
    margin-bottom: 14px;
  }

  #nlb-{{ nl_id }} .nlb__error ul { margin: 0; padding-left: 18px; }

  /* ---------- tablette ---------- */
  @media screen and (max-width: 1100px) {
    #nlb-{{ nl_id }} .nlb__card { padding: 44px 40px; }
    #nlb-{{ nl_id }} .nlb__grid { gap: 34px; }
    #nlb-{{ nl_id }} .nlb__title { font-size: 34px; }
  }

  /* ---------- mobile ---------- */
  @media screen and (max-width: 899px) {
    #nlb-{{ nl_id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #nlb-{{ nl_id }} .nlb__wrap { padding: 0 16px; }

    #nlb-{{ nl_id }} .nlb__card {
      padding: 34px 22px;
      border-radius: 22px;
    }

    #nlb-{{ nl_id }} .nlb__grid {
      grid-template-columns: 1fr;
      gap: 26px;
    }

    #nlb-{{ nl_id }} .nlb__title {
      font-size: 27px;
      line-height: 1.2;
    }

    #nlb-{{ nl_id }} .nlb__subtitle { font-size: 15px; }

    #nlb-{{ nl_id }} .nlb__benefits { margin-top: 20px; }

    #nlb-{{ nl_id }} .nlb__form-card {
      padding: 22px 20px 20px;
      border-radius: 18px;
    }

    #nlb-{{ nl_id }} .nlb__row {
      flex-wrap: wrap;
      padding: 10px 12px;
      gap: 10px;
    }

    #nlb-{{ nl_id }} .nlb__input {
      flex: 1 1 140px;
      padding: 8px 2px;
    }

    #nlb-{{ nl_id }} .nlb__btn {
      flex: 1 1 100%;
      justify-content: center;
      padding: 14px 20px;
    }

    #nlb-{{ nl_id }} .nlb__blob--a { width: 220px; height: 220px; right: -80px; top: -100px; }
    #nlb-{{ nl_id }} .nlb__blob--b { width: 180px; height: 180px; left: -90px; bottom: -100px; }
  }

  @media (prefers-reduced-motion: reduce) {
    #nlb-{{ nl_id }} .nlb__btn,
    #nlb-{{ nl_id }} .nlb__btn svg { transition: none; }
  }
</style>

{% schema %}
{
  "name": "Newsletter Zensea",
  "tag": "section",
  "class": "newsletter-velluce-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre",
      "default": "La lettre Zensea"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Sublimez votre intérieur en toute sérénité"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "Deux e-mails par mois maximum : nos conseils d'son, nos nouveautés et nos offres en avant-première. Rien d'autre."
    },
    {
      "type": "header",
      "content": "Formulaire"
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Titre du formulaire",
      "default": "Rejoignez la communauté Zensea"
    },
    {
      "type": "text",
      "id": "label_email",
      "label": "Libellé du champ",
      "default": "Votre e-mail"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Placeholder",
      "default": "marie.dupont@email.com"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texte du bouton",
      "default": "Je m'inscris"
    },
    {
      "type": "text",
      "id": "legal_text",
      "label": "Mention sous le champ",
      "default": "En vous inscrivant, vous acceptez de recevoir nos e-mails. Désinscription en un clic."
    },
    {
      "type": "text",
      "id": "reassurance",
      "label": "Ligne de réassurance",
      "default": "Vos données restent chez nous. Aucun partage, aucun spam."
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Message de succès",
      "default": "C'est fait, bienvenue chez Zensea ! Votre premier e-mail arrive très vite."
    },
    {
      "type": "header",
      "content": "Couleurs"
    },
    {
      "type": "color",
      "id": "color_beige",
      "label": "Beige",
      "default": "#B4C9BE"
    },
    {
      "type": "color",
      "id": "color_accent",
      "label": "Accent",
      "default": "#90AFA0"
    },
    {
      "type": "color",
      "id": "color_ink",
      "label": "Texte",
      "default": "#292F2C"
    },
    {
      "type": "color",
      "id": "color_soft",
      "label": "Fond doux",
      "default": "#FAF8F5"
    },
    {
      "type": "header",
      "content": "Dimensions"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Largeur maximale",
      "min": 1200,
      "max": 1600,
      "step": 20,
      "default": 1400,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espace au-dessus",
      "min": 0,
      "max": 140,
      "step": 4,
      "default": 64,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espace en dessous",
      "min": 0,
      "max": 140,
      "step": 4,
      "default": 72,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Espace au-dessus (mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 36,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Espace en dessous (mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 44,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Avantage",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Titre",
          "default": "Conseils utiles"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texte",
          "default": "Des repères concrets, testés dans de vrais intérieurs."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Newsletter Zensea",
      "blocks": [
        {
          "type": "benefit"
        },
        {
          "type": "benefit"
        },
        {
          "type": "benefit"
        }
      ]
    }
  ]
}
{% endschema %}
