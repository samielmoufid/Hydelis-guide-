      "info": "Inutile tant que le suivi des stocks est désactivé.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Barre collante au défilement",
      "default": false
    },
    {
      "type": "header",
      "content": "Tri"
    },
    {
      "type": "textarea",
      "id": "hidden_sorts",
      "label": "Options de tri à masquer",
