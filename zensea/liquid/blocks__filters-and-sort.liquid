    {
      "type": "header",
      "content": "Couleurs"
    },
    {
      "type": "color",
      "id": "color_beige",
      "label": "Beige (bordures)",
      "default": "#B4C9BE"
    },
    {
      "type": "color",
      "id": "color_accent",
      "label": "Accent",
      "default": "#90AFA0"
    },
    {
      "type": "color",
      "id": "color_ink",
      "label": "Texte / sélection",
      "default": "#292F2C"
    },
    {
      "type": "color",
      "id": "color_soft",
      "label": "Fond doux",
      "default": "#F6F9F8"
    },
    {
      "type": "header",
      "content": "Avancé"
    },
    {
      "type": "text",
      "id": "additional_class",
      "label": "Classe CSS additionnelle"
    }
  ]
}
{% endschema %}