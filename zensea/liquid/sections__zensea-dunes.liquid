<style>
  #vdn-{{ section.id }} {
    position: relative;
    width: 100%;
    height: {{ section.settings.height_desktop }}px;
    overflow: hidden;
    background: transparent;
    line-height: 0;
  }
  @media (max-width: 749px) {
    #vdn-{{ section.id }} { height: {{ section.settings.height_mobile }}px; }
    /* Le SVG est recadré sur mobile : le soleil reprend de la présence. */
    #vdn-{{ section.id }} .vdn__sun {
      transform-box: fill-box;
      transform-origin: center;
      transform: scale(1.42);
    }
    #vdn-{{ section.id }} .vdn__svg {
      -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 46px);
      mask-image: linear-gradient(to bottom, transparent 0, #000 46px);
    }
  }

  /* — Soleil : disque net derrière les collines + halo qui respire — */
  #vdn-{{ section.id }} .vdn__sun-halo {
    transform-box: fill-box;
    transform-origin: center;
    animation: vdnBreathe 7s ease-in-out infinite;
  }
  #vdn-{{ section.id }} .vdn__sun-disc {
    transform-box: fill-box;
    transform-origin: center;
    animation: vdnBreathe 7s ease-in-out infinite;
    animation-delay: .5s;
  }
  @keyframes vdnBreathe {
    0%, 100% { opacity: .9; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.028); }
  }

  #vdn-{{ section.id }} .vdn__svg {
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 78px);
    mask-image: linear-gradient(to bottom, transparent 0, #000 78px);
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* — Relief papier découpé : ombre douce sous chaque couche — */
  #vdn-{{ section.id }} .vdn__l1 { filter: drop-shadow(0 6px 10px rgba(147, 115, 39, 0.10)); }
  #vdn-{{ section.id }} .vdn__l2 { filter: drop-shadow(0 8px 12px rgba(147, 115, 39, 0.13)); }
  #vdn-{{ section.id }} .vdn__l3 { filter: drop-shadow(0 10px 16px rgba(147, 115, 39, 0.16)); }
  #vdn-{{ section.id }} .vdn__l4 { filter: drop-shadow(0 8px 12px rgba(147, 115, 39, 0.13)); }
  #vdn-{{ section.id }} .vdn__l5 { filter: drop-shadow(0 -6px 12px rgba(147, 115, 39, 0.10)); }
  #vdn-{{ section.id }} .vdn__l6 { filter: drop-shadow(0 -8px 14px rgba(147, 115, 39, 0.14)); }
  #vdn-{{ section.id }} .vdn__l7 { filter: drop-shadow(0 -6px 10px rgba(147, 115, 39, 0.12)); }

  @media (prefers-reduced-motion: reduce) {
    #vdn-{{ section.id }} .vdn__sun-halo,
    #vdn-{{ section.id }} .vdn__sun-disc { animation: none !important; }
  }
</style>

