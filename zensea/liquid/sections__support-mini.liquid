      "min": 1,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 2
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Rayon coins desktop",
      "min": 8,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Aide WhatsApp collection"
    }
  ]
}
{% endschema %}

