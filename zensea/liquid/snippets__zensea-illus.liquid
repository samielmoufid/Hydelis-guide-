{%- comment -%}
  Zensea — visuel codé (SVG) pour les cartes de collection sans photo.
  Rendu volumétrique sur fond clair : dégradés radiaux, spéculaire, ombre portée.
  Paramètres :
    key  — identifiant d'instrument / matière / usage (souvent le handle de collection)
    uid  — identifiant unique pour ne pas dupliquer les ids SVG
    name — libellé, utilisé pour l'accessibilité
    [class] — classe CSS du conteneur d'accueil (défaut : vgr__illu)
    [fit]   — preserveAspectRatio (défaut : xMidYMid slice)
{%- endcomment -%}

{%- liquid
  assign h = key | downcase
  assign k = 'handpan'

  # --- accessoires et entretien (les plus spécifiques d'abord)
  if h contains 'maillet' or h contains 'mailloche' or h contains 'entretien'
    assign k = 'maillets'
  elsif h contains 'housse' or h contains 'support' or h contains 'transport' or h contains 'sac'
    assign k = 'housse'
  elsif h contains 'accessoire'
    assign k = 'accessoires'

  # --- familles d'instruments
  elsif h contains 'tongue' or h contains 'langue'
    assign k = 'tongue'
  elsif h contains 'kalimba' or h contains 'pouce'
    assign k = 'kalimba'
  elsif h contains 'bol' or h contains 'chantant' or h contains 'tibet'
    assign k = 'bol'
  elsif h contains 'ocarina' or h contains 'flute'
    assign k = 'ocarina'

  # --- guides et pédagogie
  elsif h contains 'guide' or h contains 'debutant' or h contains 'commencer' or h contains 'apprendre'
    assign k = 'guide'

  # --- handpans par nombre de notes
  elsif h contains '12-notes' or h contains '12 notes' or h contains '13-notes'
    assign k = 'handpan12'
  elsif h contains '10-notes' or h contains '10 notes' or h contains '11-notes'
    assign k = 'handpan12'
  elsif h contains '9-notes' or h contains '9 notes' or h contains '8-notes'
    assign k = 'handpan'

  # --- handpans (le plus générique, testé en dernier)
  elsif h contains 'handpan' or h contains '440' or h contains 'hang'
    assign k = 'handpan'
  endif

  assign u = uid | default: 'x'
-%}

<svg class="{{ class | default: 'vgr__illu' }}" viewBox="0 0 400 420" role="img" aria-label="{{ name | default: 'Zensea' | escape }}" preserveAspectRatio="{{ fit | default: 'xMidYMid slice' }}" style="width:100%;height:100%;display:block" xmlns="http://www.w3.org/2000/svg">
