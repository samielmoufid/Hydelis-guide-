      <stop offset="0" stop-color="#4C6C5A"/>
      <stop offset="1" stop-color="#1F3D2F"/>
    </linearGradient>
    <radialGradient id="dome{{ u }}" cx="38%" cy="28%" r="78%">
      <stop offset="0" stop-color="#ffffff" stop-opacity=".92"/>
      <stop offset="0.45" stop-color="#B9CEC3"/>
      <stop offset="1" stop-color="#54725F"/>
    </radialGradient>
    <radialGradient id="creux{{ u }}" cx="42%" cy="34%" r="80%">
