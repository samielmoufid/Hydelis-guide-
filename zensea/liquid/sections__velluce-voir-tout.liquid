{%- liquid
  assign s = section.settings
  assign col = s.collection
  assign nom = s.nom
  if nom == blank and col != blank
    assign nom = col.title
  endif
  comment
    Lien de la famille, resolu dans cet ordre :
    1. le lien saisi a la main (ignore s'il reste au format shopify:// non resolu)
    2. l'URL reelle de la collection choisie
    3. repli sur tout le catalogue
  endcomment
  assign lien = ''
  if col != blank
    assign lien = '/collections/' | append: col.handle
  endif
  if lien == blank
    assign lien = s.lien
    if lien contains 'shopify://'
      assign lien = ''
    endif
  endif
  if lien == blank
    assign lien = '/collections/all'
  endif
  assign nb = 0
  if col != blank
    assign nb = col.all_products_count
  endif
  assign visuel = s.image
  if visuel == blank and col != blank
    assign visuel = col.image
  endif
-%}

<section id="vvt-{{ section.id }}" class="vvt">
  <div class="vvt__wrap">

    <div class="vvt__text">
      {%- if s.eyebrow != blank -%}
        <p class="vvt__eyebrow"><span class="vvt__rule"></span>{{ s.eyebrow }}</p>
      {%- endif -%}

      <h2 class="vvt__title">
        <a class="vvt__titlelink" href="{{ lien }}">{{ s.prefixe | strip }} <span class="vvt__accent">{{ nom | downcase }}</span></a>
      </h2>

      {%- if s.intro != blank -%}<p class="vvt__intro">{{ s.intro }}</p>{%- endif -%}

      <a class="vvt__cta" href="{{ lien }}">
        <span>{{ s.cta }}</span>
        {%- if s.show_count and nb > 0 -%}<em class="vvt__nb">{{ nb }}</em>{%- endif -%}
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>

    {%- if s.show_visuel -%}
      <a class="vvt__media" href="{{ lien }}" aria-label="{{ s.prefixe | strip }} {{ nom }}">
        {%- if visuel != blank -%}
          {{ visuel | image_url: width: 900 | image_tag: loading: 'lazy', class: 'vvt__img', alt: nom }}
        {%- else -%}
          {%- assign ik = nom | downcase -%}
          {%- if col != blank -%}{%- assign ik = col.handle -%}{%- endif -%}
          {%- render 'velluce-illus', key: ik, uid: section.id, name: nom -%}
        {%- endif -%}
      </a>
    {%- endif -%}

  </div>
</section>

<style>
  #vvt-{{ section.id }} {
    --vvt-ink: {{ s.ink }};
    --vvt-accent: {{ s.accent }};
    background: {{ s.bg }};
    padding: {{ s.pad_top }}px 0 {{ s.pad_bottom }}px;
  }
  #vvt-{{ section.id }} .vvt__wrap {
    max-width: {{ s.max_width }}px;
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 56px);
    display: grid;
    grid-template-columns: {% if s.show_visuel %}1fr minmax(0, {{ s.media_w }}px){% else %}1fr{% endif %};
    align-items: center;
    gap: clamp(24px, 5vw, 64px);
  }

  #vvt-{{ section.id }} .vvt__eyebrow {
    display: flex; align-items: center; gap: 12px;
    margin: 0 0 18px;
    font-size: 11px; letter-spacing: .22em; text-transform: uppercase;
    color: var(--vvt-accent); font-weight: 500;
  }
  #vvt-{{ section.id }} .vvt__rule { width: 32px; height: 1px; background: currentColor; opacity: .6; }

  #vvt-{{ section.id }} .vvt__titlelink {
    display: inline;
    text-decoration: none;
    color: inherit;
  }
  #vvt-{{ section.id }} .vvt__title {
    margin: 0;
    font-family: var(--font-heading--family, Georgia, serif);
    font-weight: 400;
    font-size: {{ s.title_size }}px;
    line-height: 1.08;
    letter-spacing: -.015em;
    color: var(--vvt-ink);
  }
  #vvt-{{ section.id }} .vvt__accent {
    font-style: italic;
    color: var(--vvt-accent);
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 100% 1px;
    background-repeat: no-repeat;
    background-position: 0 92%;
    padding-bottom: 3px;
    transition: background-size .5s cubic-bezier(.2,.7,.2,1);
  }
  #vvt-{{ section.id }} .vvt__titlelink:hover .vvt__accent { background-size: 0% 1px; background-position: 100% 92%; }
  #vvt-{{ section.id }} .vvt__titlelink:hover { color: var(--vvt-accent); }
  #vvt-{{ section.id }} .vvt__title { transition: color .35s ease; }

  #vvt-{{ section.id }} .vvt__intro {
    margin: 16px 0 0;
    max-width: 46ch;
    font-size: 16px; line-height: 1.7;
    color: var(--vvt-ink); opacity: .62;
  }

  #vvt-{{ section.id }} .vvt__cta {
    display: inline-flex; align-items: center; gap: 12px;
    margin-top: {{ s.cta_gap }}px;
    padding: 15px 26px;
    font-size: 12.5px; letter-spacing: .16em; text-transform: uppercase;
    color: var(--vvt-ink);
    text-decoration: none;
    border: 1px solid var(--vvt-ink);
    border-radius: 999px;
    cursor: pointer;
    -webkit-tap-highlight-color: rgba(203,160,60,.25);
    transition: background .35s ease, color .35s ease, transform .2s ease;
  }
  #vvt-{{ section.id }} .vvt__cta:hover { background: var(--vvt-ink); color: #fff; }
  #vvt-{{ section.id }} .vvt__cta:active { transform: scale(.97); }
  #vvt-{{ section.id }} .vvt__cta:hover .vvt__nb { color: #fff; }
  #vvt-{{ section.id }} .vvt__nb {
    font-style: normal;
    font-size: 11px; letter-spacing: .08em;
    color: var(--vvt-accent);
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 3px 9px;
    opacity: .85;
  }
  #vvt-{{ section.id }} .vvt__cta svg { width: 18px; height: 18px; transition: transform .45s cubic-bezier(.2,.7,.2,1); }
  #vvt-{{ section.id }} .vvt__cta:hover svg { transform: translateX(6px); }

  #vvt-{{ section.id }} .vvt__media {
    display: block;
    text-decoration: none;
    position: relative;
    aspect-ratio: {{ s.ratio }};
    border-radius: {{ s.radius }}px;
    overflow: hidden;
    background: {{ s.media_bg }};
  }
  #vvt-{{ section.id }} .vvt__img,
  #vvt-{{ section.id }} .vgr__illu {
    width: 100%; height: 100%;
    object-fit: {{ s.fit }};
    {% if s.fit == 'contain' %}padding: 8%;{% endif %}
    display: block;
    transition: transform 1.1s cubic-bezier(.2,.7,.2,1);
  }
  #vvt-{{ section.id }} .vvt__media:hover .vvt__img,
  #vvt-{{ section.id }} .vvt__media:hover .vgr__illu { transform: scale(1.04); }

  #vvt-{{ section.id }}::after {
    content: "";
    display: block;
    max-width: {{ s.max_width }}px;
    margin: {{ s.pad_bottom }}px auto 0;
    height: 1px;
    background: {{ s.accent }}2E;
    opacity: {% if s.filet %}1{% else %}0{% endif %};
  }

  @media (max-width: 749px) {
    #vvt-{{ section.id }} { padding: {{ s.pad_top_m }}px 0 {{ s.pad_bottom_m }}px; }
    #vvt-{{ section.id }} .vvt__wrap {
      grid-template-columns: 1fr;
      gap: 22px;
      padding: 0 20px;
    }
    #vvt-{{ section.id }} .vvt__title { font-size: {{ s.title_size_m }}px; line-height: 1.12; }
    #vvt-{{ section.id }} .vvt__eyebrow { margin-bottom: 12px; font-size: 10px; }
    #vvt-{{ section.id }} .vvt__intro { font-size: 14.5px; margin-top: 12px; }
    #vvt-{{ section.id }} .vvt__cta { margin-top: {{ s.cta_gap_m }}px; font-size: 11.5px; }
    #vvt-{{ section.id }} .vvt__media { aspect-ratio: {{ s.ratio_m }}; order: -1; }
    #vvt-{{ section.id }}::after { margin-top: {{ s.pad_bottom_m }}px; }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('vvt-{{ section.id }}');
    if (!root) return;
    /* Certains scripts de theme interceptent le clic avant le lien.
       On capte donc le clic en amont et on navigue nous-memes. */
    root.addEventListener('click', function (e) {
      var a = e.target.closest ? e.target.closest('a[href]') : null;
      if (!a || !root.contains(a)) return;
      if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      var href = a.getAttribute('href');
      if (!href || href.charAt(0) === '#') return;
      e.preventDefault();
      e.stopPropagation();
      window.location.assign(href);
    }, true);
  })();
</script>

{% schema %}
{
  "name": "Voir toute la famille",
  "tag": "section",
  "class": "vvt-section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection cible"
    },
    {
      "type": "text",
      "id": "nom",
      "label": "Nom affiché (sinon celui de la collection)"
    },
    {
      "type": "url",
      "id": "lien",
      "label": "Lien (sinon celui de la collection)"
    },
    {
      "type": "header",
      "content": "Textes"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre",
      "default": "La famille au complet"
    },
    {
      "type": "text",
      "id": "prefixe",
      "label": "Début du titre",
      "default": "Voir toutes nos "
    },
    {
      "type": "text",
      "id": "intro",
      "label": "Une ligne d'introduction",
      "default": "Tous les modèles réunis, toutes matières et tous styles confondus."
    },
    {
      "type": "text",
      "id": "cta",
      "label": "Texte du lien",
      "default": "Découvrir la collection"
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Afficher le nombre de modèles",
      "default": true
    },
    {
      "type": "header",
      "content": "Visuel"
    },
    {
      "type": "checkbox",
      "id": "show_visuel",
      "label": "Afficher un visuel à droite",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (sinon celle de la collection)"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Format du visuel",
      "options": [
        {
          "value": "16 / 10",
          "label": "Paysage"
        },
        {
          "value": "4 / 3",
          "label": "Classique"
        },
        {
          "value": "1 / 1",
          "label": "Carré"
        }
      ],
      "default": "4 / 3"
    },
    {
      "type": "select",
      "id": "ratio_m",
      "label": "Format du visuel — mobile",
      "options": [
        {
          "value": "16 / 9",
          "label": "Bandeau"
        },
        {
          "value": "4 / 3",
          "label": "Classique"
        },
        {
          "value": "1 / 1",
          "label": "Carré"
        }
      ],
      "default": "16 / 9"
    },
    {
      "type": "select",
      "id": "fit",
      "label": "Cadrage",
      "options": [
        {
          "value": "cover",
          "label": "Remplir le cadre"
        },
        {
          "value": "contain",
          "label": "Produit entier visible"
        }
      ],
      "default": "cover"
    },
    {
      "type": "range",
      "id": "media_w",
      "min": 240,
      "max": 640,
      "step": 10,
      "unit": "px",
      "label": "Largeur du visuel",
      "default": 420
    },
    {
      "type": "range",
      "id": "radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Arrondi du visuel",
      "default": 6
    },
    {
      "type": "color",
      "id": "media_bg",
      "label": "Fond du visuel",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Couleurs"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Fond de la section",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "ink",
      "label": "Couleur du texte",
      "default": "#0D1712"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Couleur d'accent",
      "default": "#CBA03C"
    },
    {
      "type": "checkbox",
      "id": "filet",
      "label": "Filet de séparation en bas",
      "default": true
    },
    {
      "type": "header",
      "content": "Dimensions"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 26,
      "max": 68,
      "step": 2,
      "unit": "px",
      "label": "Taille du titre",
      "default": 44
    },
    {
      "type": "range",
      "id": "title_size_m",
      "min": 20,
      "max": 46,
      "step": 2,
      "unit": "px",
      "label": "Taille du titre — mobile",
      "default": 30
    },
    {
      "type": "range",
      "id": "cta_gap",
      "min": 12,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "Espace au-dessus du lien",
      "default": 34
    },
    {
      "type": "range",
      "id": "cta_gap_m",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Espace au-dessus du lien — mobile",
      "default": 22
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 900,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "label": "Largeur maximale",
      "default": 1280
    },
    {
      "type": "range",
      "id": "pad_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding haut",
      "default": 72
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bas",
      "default": 64
    },
    {
      "type": "range",
      "id": "pad_top_m",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding haut — mobile",
      "default": 40
    },
    {
      "type": "range",
      "id": "pad_bottom_m",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bas — mobile",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Voir toute la famille"
    }
  ]
}
{% endschema %}
