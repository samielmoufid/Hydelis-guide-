{% comment %} sections/newsletter-premium.liquid {% endcomment %}

<section class="newsletter-premium" id="newsletter-premium-{{ section.id }}">
  <div class="newsletter-premium__wrapper">

    {% assign newsletter_form_id = 'newsletter-form-' | append: section.id %}

    {% form 'customer', id: newsletter_form_id %}
      <input type="hidden" name="contact[tags]" value="newsletter">

      {% if form.posted_successfully? %}
        <div class="newsletter-premium__success">
          {{ section.settings.success_message }}
        </div>
      {% else %}

        <div class="newsletter-premium__inner">

          <div class="newsletter-premium__text">
            <h2 class="newsletter-premium__title">{{ section.settings.title }}</h2>
            <p class="newsletter-premium__subtitle">{{ section.settings.subtitle }}</p>
          </div>

          <div class="newsletter-premium__form-group">
            {% if form.errors %}
              <div class="newsletter-premium__error">
                {{ form.errors | default_errors }}
              </div>
            {% endif %}

            <div class="newsletter-premium__input-wrapper">
              <input
                type="email"
                name="contact[email]"
                id="newsletter-email-{{ section.id }}"
                class="newsletter-premium__input"
                placeholder="{{ section.settings.email_placeholder }}"
                autocomplete="email"
                required
                aria-label="{{ section.settings.email_placeholder }}"
              >

              <button type="submit" class="newsletter-premium__btn" aria-label="S'abonner">
                <span aria-hidden="true">→</span>
              </button>
            </div>
          </div>

        </div>

      {% endif %}
    {% endform %}

  </div>
</section>

<style>
  #newsletter-premium-{{ section.id }} {
    --nl-bg: {{ section.settings.bg_color }};
  }

  .newsletter-premium {
    background: #ffffff;
    padding: 40px 20px;
    box-sizing: border-box;
  }

  .newsletter-premium__wrapper {
    background: var(--nl-bg);
    border-radius: 14px;
    max-width: 1600px;
    width: 88%;
    margin: 0 auto;
    min-height: 150px;
    display: flex;
    align-items: center;
    padding: 40px 56px;
    box-sizing: border-box;
  }

  .newsletter-premium form {
    width: 100%;
  }

  .newsletter-premium__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: 40px;
  }

  .newsletter-premium__text {
    flex: 1 1 auto;
    min-width: 0;
  }

  .newsletter-premium__title {
    color: #ffffff;
    font-size: 26px;
    font-weight: 700;
    line-height: 1.25;
    margin: 0 0 8px 0;
    letter-spacing: -0.01em;
  }

  .newsletter-premium__subtitle {
    color: rgba(255, 255, 255, 0.85);
    font-size: 15px;
    font-weight: 400;
    line-height: 1.5;
    margin: 0;
  }

  .newsletter-premium__form-group {
    flex: 0 0 auto;
    width: 470px;
    max-width: 100%;
  }

  .newsletter-premium__input-wrapper {
    display: flex;
    align-items: center;
    border: 1.5px solid rgba(255, 255, 255, 0.45);
    border-radius: 8px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.06);
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .newsletter-premium__input-wrapper:focus-within {
    border-color: rgba(255, 255, 255, 0.8);
    background: rgba(255, 255, 255, 0.1);
  }

  .newsletter-premium__input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: #ffffff;
    font-size: 15px;
    padding: 15px 18px;
    min-width: 0;
    font-family: inherit;
  }

  .newsletter-premium__input::placeholder {
    color: rgba(255, 255, 255, 0.6);
  }

  .newsletter-premium__btn {
    background: transparent;
    border: none;
    color: #ffffff;
    font-size: 22px;
    padding: 14px 18px;
    cursor: pointer;
    line-height: 1;
    transition: opacity 0.2s ease, transform 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .newsletter-premium__btn:hover {
    opacity: 0.75;
    transform: translateX(2px);
  }

  .newsletter-premium__success {
    color: #ffffff;
    font-size: 16px;
    font-weight: 500;
    text-align: center;
    width: 100%;
    padding: 8px 0;
  }

  .newsletter-premium__error {
    color: #ffffff;
    font-size: 13px;
    margin: 0 0 8px 0;
  }

  .newsletter-premium__error ul {
    margin: 0;
    padding-left: 18px;
  }

  @media (max-width: 768px) {
    .newsletter-premium {
      padding: 24px 16px;
    }

    .newsletter-premium__wrapper {
      width: 100%;
      padding: 28px 24px;
      min-height: auto;
      border-radius: 12px;
    }

    .newsletter-premium__inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }

    .newsletter-premium__title {
      font-size: 22px;
    }

    .newsletter-premium__subtitle {
      font-size: 14px;
    }

    .newsletter-premium__form-group {
      width: 100%;
    }

    .newsletter-premium__input {
      padding: 14px 16px;
    }
  }
</style>

{% schema %}
{
  "name": "Newsletter Premium",
  "tag": "section",
  "class": "newsletter-premium-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Abonnez-vous à notre newsletter"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "Recevez nos nouveautés et offres exclusives en avant-première."
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Placeholder email",
      "default": "E-mail"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Couleur du fond",
      "default": "#0B239F"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Message de succès",
      "default": "Merci pour votre inscription ! Vous recevrez bientôt nos actualités."
    }
  ],
  "presets": [
    {
      "name": "Newsletter Premium"
    }
  ]
}
{% endschema %}