<section
  id="velluce-hero-impact-{{ section.id }}"
  class="velluce-hero-impact"
  style="
    --hero-h-desk: {{ section.settings.desktop_height }}px;
    --hero-h-mob: {{ section.settings.mobile_height }}px;
    --desk-pos: {{ section.settings.desktop_position }};
    --mob-pos: {{ section.settings.mobile_position }};
    --overlay-opacity: calc({{ section.settings.overlay_opacity }} / 100);
  "
>
  <div class="velluce-hero-impact__media">
    {%- if section.settings.desktop_video_url != blank -%}
      <video
        class="velluce-hero-impact__video velluce-hero-impact__video--desk"
        src="{{ section.settings.desktop_video_url }}"
        autoplay
        muted
        loop
        playsinline
        style="object-position: var(--desk-pos);"
      ></video>
    {%- elsif section.settings.desktop_image != blank -%}
      <img
        class="velluce-hero-impact__img velluce-hero-impact__img--desk"
        src="{{ section.settings.desktop_image | image_url: width: 1920 }}"
        srcset="
          {{ section.settings.desktop_image | image_url: width: 800 }} 800w,
          {{ section.settings.desktop_image | image_url: width: 1200 }} 1200w,
          {{ section.settings.desktop_image | image_url: width: 1920 }} 1920w
        "
        sizes="100vw"
        alt="{{ section.settings.title | escape }}"
        loading="eager"
        fetchpriority="high"
        style="object-position: var(--desk-pos);"
      >
    {%- endif -%}

    {%- if section.settings.mobile_video_url != blank -%}
      <video
        class="velluce-hero-impact__video velluce-hero-impact__video--mob"
        src="{{ section.settings.mobile_video_url }}"
        autoplay
        muted
        loop
        playsinline
        style="object-position: var(--mob-pos);"
      ></video>
    {%- elsif section.settings.mobile_image != blank -%}
      <img
        class="velluce-hero-impact__img velluce-hero-impact__img--mob"
        src="{{ section.settings.mobile_image | image_url: width: 900 }}"
        alt="{{ section.settings.title | escape }}"
        loading="eager"
        fetchpriority="high"
        style="object-position: var(--mob-pos);"
      >
    {%- endif -%}
  </div>

  <div class="velluce-hero-impact__overlay"></div>

  <div class="velluce-hero-impact__container">
    <div class="velluce-hero-impact__content">

      {%- if section.settings.rating_text != blank -%}
        <div class="velluce-hero-impact__rating">
          <span class="velluce-hero-impact__stars" aria-label="Note 4,8 sur 5">
            <span style="--fill:100%;">★</span>
            <span style="--fill:100%;">★</span>
            <span style="--fill:100%;">★</span>
            <span style="--fill:100%;">★</span>
            <span style="--fill:80%;">★</span>
          </span>

          <span class="velluce-hero-impact__rating-text">
            {{ section.settings.rating_text }}
          </span>
        </div>
      {%- endif -%}

      {%- if section.settings.eyebrow != blank -%}
        <p class="velluce-hero-impact__eyebrow">
          {{ section.settings.eyebrow }}
        </p>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h1 class="velluce-hero-impact__title">
          {%- if section.settings.mobile_title != blank -%}
            <span class="velluce-hero-impact__title--desk">
              {{ section.settings.title }}
            </span>
            <span class="velluce-hero-impact__title--mob">
              {{ section.settings.mobile_title }}
            </span>
          {%- else -%}
            {{ section.settings.title }}
          {%- endif -%}
        </h1>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <p class="velluce-hero-impact__desc">
          {%- if section.settings.mobile_description != blank -%}
            <span class="velluce-hero-impact__desc--desk">
              {{ section.settings.description }}
            </span>
            <span class="velluce-hero-impact__desc--mob">
              {{ section.settings.mobile_description }}
            </span>
          {%- else -%}
            {{ section.settings.description }}
          {%- endif -%}
        </p>
      {%- endif -%}

      {%- if section.settings.primary_label != blank -%}
        <div class="velluce-hero-impact__buttons">
          <a href="{{ section.settings.primary_link }}" class="velluce-hero-impact__btn velluce-hero-impact__btn--primary">
            {{ section.settings.primary_label }}
          </a>

          {%- if section.settings.secondary_label != blank -%}
            <a href="{{ section.settings.secondary_link }}" class="velluce-hero-impact__btn velluce-hero-impact__btn--secondary">
              {{ section.settings.secondary_label }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="velluce-hero-impact__trust">
        <div class="velluce-hero-impact__trust-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 21s7-3.6 7-9V6.2L12 3 5 6.2V12c0 5.4 7 9 7 9z"></path>
            <path d="M9.5 12.2l1.6 1.6 3.4-3.6"></path>
          </svg>
          <span>Garantie 24 mois</span>
        </div>

        <div class="velluce-hero-impact__trust-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 11a8 8 0 1 0 2.2-5.5"></path>
            <path d="M3 4v5h5"></path>
          </svg>
          <span>Retours 30 jours</span>
        </div>

        <div class="velluce-hero-impact__trust-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15a3 3 0 0 1-3 3H8l-5 3V6a3 3 0 0 1 3-3h12a3 3 0 0 1 3 3z"></path>
          </svg>
          <span>Support 7j/7</span>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  #velluce-hero-impact-{{ section.id }} {
    position: relative;
    width: 100%;
    height: var(--hero-h-desk);
    min-height: 500px;
    display: flex;
    align-items: center;
    overflow: hidden;
    color: #fff;
    isolation: isolate;
  }

  #velluce-hero-impact-{{ section.id }} * {
    box-sizing: border-box;
  }

  #velluce-hero-impact-{{ section.id }} .velluce-hero-impact__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: #000;
  }

  #velluce-hero-impact-{{ section.id }} .velluce-hero-impact__video,
  #velluce-hero-impact-{{ section.id }} .velluce-hero-impact__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 1 !important;
    filter: none !important;
  }

  #velluce-hero-impact-{{ section.id }} .velluce-hero-impact__video--mob,
  #velluce-hero-impact-{{ section.id }} .velluce-hero-impact__img--mob {
    display: none;
  }

  #velluce-hero-impact-{{ section.id }} .velluce-hero-impact__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: #000;
    opacity: var(--overlay-opacity);
    pointer-events: none;
  }

  #velluce-hero-impact-{{ section.id }} .velluce-hero-impact__container {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-inline-start: max(var(--container-gutter, 24px), 50% - var(--container-max-width, 1280px) / 2);
    padding-inline-end: max(var(--container-gutter, 24px), 50% - var(--container-max-width, 1280px) / 2);
  }

  /* PC : tailles réduites */
  #velluce-hero-impact-{{ section.id }} .velluce-hero-impact__content {
    width: 100%;
    max-width: 700px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: flex-start;
  }

  #velluce-hero-impact-{{ section.id }} .velluce-hero-impact__rating {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: nowrap;
    max-width: 700px;
  }

  #velluce-hero-impact-{{ section.id }} .velluce-hero-impact__stars {
    display: flex;
    align-items: center;
    gap: 2px;
    flex-shrink: 0;
  }

  #velluce-hero-impact-{{ section.id }} .velluce-hero-impact__stars span {
    width: 16px;
    height: 16px;
    background: linear-gradient(to right, #00b67a var(--fill), #D7DBD9 var(--fill));
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    line-height: 1;
    font-weight: 700;
    border-radius: 1px;
  }

  #velluce-hero-impact-{{ section.id }} .velluce-hero-impact__rating-text {
    font-size: 12px;
    font-weight: 600;
    opacity: 0.96;
    letter-spacing: 0.01em;
    color: #fff !important;
    line-height: 1.2;
  }

  #velluce-hero-impact-{{ section.id }} .velluce-hero-impact__eyebrow {
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.78;
    margin: 0;
    max-width: 700px;
    color: #fff !important;
  }

  #velluce-hero-impact-{{ section.id }} .velluce-hero-impact__title {
    width: 100%;
    max-width: 700px;
    font-size: clamp(28px, 3.2vw, 48px);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.025em;
    margin: 0;
    word-break: normal;
    overflow-wrap: normal;
    color: #fff !important;
  }

  #velluce-hero-impact-{{ section.id }} .velluce-hero-impact__title span {
    color: #fff !important;
  }

  #velluce-hero-impact-{{ section.id }} .velluce-hero-impact__title--mob {
    display: none;
  }

  #velluce-hero-impact-{{ section.id }} .velluce-hero-impact__desc {
    width: 100%;
    max-width: 620px;
    font-size: 13px;
    line-height: 1.55;
    opacity: 0.95;
    margin: 0;
    color: #fff !important;
  }

  #velluce-hero-impact-{{ section.id }} .velluce-hero-impact__desc span {
    color: #fff !important;
  }

  #velluce-hero-impact-{{ section.id }} .velluce-hero-impact__desc--mob {
    display: none;
  }

  #velluce-hero-impact-{{ section.id }} .velluce-hero-impact__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 6px;
    max-width: 700px;
  }

  #velluce-hero-impact-{{ section.id }} .velluce-hero-impact__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 11px 24px;
    font-size: 12px;
    font-weight: 650;
    letter-spacing: 0.03em;
    border-radius: var(--rounded-button, 4px);
    text-decoration: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
    white-space: nowrap;
    cursor: pointer;
  }

  #velluce-hero-impact-{{ section.id }} .velluce-hero-impact__btn:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  #velluce-hero-impact-{{ section.id }} .velluce-hero-impact__btn--primary {
    background: #BFD0C8;
    color: #fff;
    border: 2px solid #BFD0C8;
  }

  #velluce-hero-impact-{{ section.id }} .velluce-hero-impact__btn--secondary {
    background: transparent;
    color: #fff;
    border: 2px solid rgba(255, 255, 255, 0.72);
  }

  #velluce-hero-impact-{{ section.id }} .velluce-hero-impact__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    margin-top: 4px;
    max-width: 700px;
  }

  #velluce-hero-impact-{{ section.id }} .velluce-hero-impact__trust-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    font-weight: 500;
    opacity: 0.9;
    color: #fff !important;
  }

  #velluce-hero-impact-{{ section.id }} .velluce-hero-impact__trust-item svg {
    width: 17px;
    height: 17px;
    flex: 0 0 17px;
    stroke: currentColor;
  }

  /* MOBILE : garde les tailles mobile */
  @media screen and (max-width: 749px) {
    #velluce-hero-impact-{{ section.id }} {
      height: var(--hero-h-mob);
      align-items: flex-end;
      padding-bottom: 32px;
    }

    #velluce-hero-impact-{{ section.id }} .velluce-hero-impact__video--desk,
    #velluce-hero-impact-{{ section.id }} .velluce-hero-impact__img--desk {
      display: none;
    }

    #velluce-hero-impact-{{ section.id }} .velluce-hero-impact__video--mob,
    #velluce-hero-impact-{{ section.id }} .velluce-hero-impact__img--mob {
      display: block;
    }

    #velluce-hero-impact-{{ section.id }} .velluce-hero-impact__overlay {
      background: #000;
      opacity: var(--overlay-opacity);
    }

    #velluce-hero-impact-{{ section.id }} .velluce-hero-impact__container {
      padding-inline-start: 18px;
      padding-inline-end: 18px;
    }

    #velluce-hero-impact-{{ section.id }} .velluce-hero-impact__content {
      max-width: 100%;
      gap: 10px;
    }

    #velluce-hero-impact-{{ section.id }} .velluce-hero-impact__title--desk {
      display: none;
    }

    #velluce-hero-impact-{{ section.id }} .velluce-hero-impact__title--mob {
      display: inline;
    }

    #velluce-hero-impact-{{ section.id }} .velluce-hero-impact__desc--desk {
      display: none;
    }

    #velluce-hero-impact-{{ section.id }} .velluce-hero-impact__desc--mob {
      display: inline;
    }

    #velluce-hero-impact-{{ section.id }} .velluce-hero-impact__rating {
      gap: 6px;
      flex-wrap: nowrap;
    }

    #velluce-hero-impact-{{ section.id }} .velluce-hero-impact__stars {
      gap: 1px;
    }

    #velluce-hero-impact-{{ section.id }} .velluce-hero-impact__stars span {
      width: 14px;
      height: 14px;
      font-size: 9px;
      border-radius: 1px;
    }

    #velluce-hero-impact-{{ section.id }} .velluce-hero-impact__rating-text {
      font-size: 11px;
      font-weight: 600;
      white-space: nowrap;
    }

    #velluce-hero-impact-{{ section.id }} .velluce-hero-impact__eyebrow {
      font-size: 9px;
    }

    #velluce-hero-impact-{{ section.id }} .velluce-hero-impact__title {
      font-size: clamp(24px, 7.5vw, 36px);
      line-height: 1.05;
    }

    #velluce-hero-impact-{{ section.id }} .velluce-hero-impact__desc {
      font-size: 14px;
      line-height: 1.45;
      max-width: 340px;
    }

    #velluce-hero-impact-{{ section.id }} .velluce-hero-impact__buttons {
      flex-direction: column;
      width: 100%;
    }

    #velluce-hero-impact-{{ section.id }} .velluce-hero-impact__btn {
      width: 100%;
      padding: 13px 20px;
      font-size: 14px;
    }

    #velluce-hero-impact-{{ section.id }} .velluce-hero-impact__trust {
      gap: 8px 14px;
    }

    #velluce-hero-impact-{{ section.id }} .velluce-hero-impact__trust-item {
      gap: 8px;
      font-size: 11px;
    }

    #velluce-hero-impact-{{ section.id }} .velluce-hero-impact__trust-item svg {
      width: 18px;
      height: 18px;
      flex: 0 0 18px;
    }
  }
</style>

{% schema %}
{
  "name": "Zensea Hero Impact",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Médias desktop"
    },
    {
      "type": "text",
      "id": "desktop_video_url",
      "label": "URL vidéo MP4 desktop"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Image desktop"
    },
    {
      "type": "select",
      "id": "desktop_position",
      "label": "Cadrage desktop",
      "default": "center center",
      "options": [
        {
          "value": "center center",
          "label": "Centre"
        },
        {
          "value": "center top",
          "label": "Centre haut"
        },
        {
          "value": "center bottom",
          "label": "Centre bas"
        },
        {
          "value": "left center",
          "label": "Gauche"
        },
        {
          "value": "right center",
          "label": "Droite"
        }
      ]
    },
    {
      "type": "header",
      "content": "Médias mobile"
    },
    {
      "type": "text",
      "id": "mobile_video_url",
      "label": "URL vidéo MP4 mobile"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Image mobile"
    },
    {
      "type": "select",
      "id": "mobile_position",
      "label": "Cadrage mobile",
      "default": "center center",
      "options": [
        {
          "value": "center center",
          "label": "Centre"
        },
        {
          "value": "center top",
          "label": "Centre haut"
        },
        {
          "value": "center bottom",
          "label": "Centre bas"
        },
        {
          "value": "left center",
          "label": "Gauche"
        },
        {
          "value": "right center",
          "label": "Droite"
        }
      ]
    },
    {
      "type": "header",
      "content": "Filtre image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Voile noir sur l’image",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 55
    },
    {
      "type": "header",
      "content": "Hauteur"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Hauteur desktop (px)",
      "min": 500,
      "max": 980,
      "step": 20,
      "default": 820
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Hauteur mobile (px)",
      "min": 500,
      "max": 860,
      "step": 20,
      "default": 740
    },
    {
      "type": "header",
      "content": "Contenu"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Texte avis",
      "default": "4,8/5 — Plus de 2 000 intérieurs illuminés"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Petit titre",
      "default": "N°1 LUMINAIRES DESIGN"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Titre desktop",
      "default": "Le son juste, l'ambiance parfaite"
    },
    {
      "type": "textarea",
      "id": "mobile_title",
      "label": "Titre mobile",
      "default": "Le son juste, l'ambiance parfaite"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description desktop",
      "default": "Handpans orientables, tongue drums et bols chantants design pensés pour sublimer chaque pièce avec élégance, chaleur et caractère."
    },
    {
      "type": "textarea",
      "id": "mobile_description",
      "label": "Description mobile",
      "default": "Des instruments élégants, durables et faciles à poser pour illuminer chaque pièce de votre intérieur."
    },
    {
      "type": "header",
      "content": "Boutons"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Bouton principal",
      "default": "Découvrir"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Lien bouton principal"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Bouton secondaire"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Lien bouton secondaire"
    }
  ],
  "presets": [
    {
      "name": "Zensea Hero Impact"
    }
  ]
}
{% endschema %}