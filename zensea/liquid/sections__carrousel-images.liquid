      "type": "header",
      "content": "Légendes"
    },
    {
      "type": "range",
      "id": "cap_size",
      "label": "Taille légende",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "color",
      "id": "cap_color",
      "label": "Couleur légende",
      "default": "#505A55"
    },
    {
      "type": "select",
      "id": "cap_align",
      "label": "Alignement légende",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Gauche"
        },
        {
          "value": "center",
          "label": "Centre"
        }
      ]
    },
    {
      "type": "header",
      "content": "Flèches — style"
    },
    {
      "type": "color",
      "id": "nav_bg",
      "label": "Fond des flèches",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "nav_color",
      "label": "Couleur des flèches",
      "default": "#181C1A"
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Couleur de fond",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Marge haute — ordinateur",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "pad_bot",
      "label": "Marge basse — ordinateur",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "pad_top_m",
      "label": "Marge haute — mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "pad_bot_m",
      "label": "Marge basse — mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Vidéo ou image",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Vidéo (prioritaire sur l'image)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (ou vignette de la vidéo)"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Légende (optionnel)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Lien (optionnel)"
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Carrousel d'images",
