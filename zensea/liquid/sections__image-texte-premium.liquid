      "default": true
    },
    {
      "type": "range",
      "id": "text_size_desktop",
      "label": "Taille texte desktop",
      "min": 14,
      "max": 26,
      "step": 1,
      "default": 17,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "label": "Taille texte mobile",
      "min": 13,
      "max": 26,
      "step": 1,
      "default": 15,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "text_line_height",
      "label": "Interligne",
      "min": 1.2,
      "max": 2.2,
      "step": 0.1,
      "default": 1.8
    },
    {
      "type": "range",
      "id": "paragraph_spacing",
      "label": "Espace entre paragraphes",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Bouton — dimensions"
    },
    {
      "type": "range",
      "id": "button_text_size",
      "label": "Taille texte bouton desktop",
      "min": 11,
      "max": 22,
      "step": 1,
      "default": 13,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "button_text_size_mobile",
      "label": "Taille texte bouton mobile",
      "min": 11,
      "max": 22,
      "step": 1,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "button_height_desktop",
      "label": "Hauteur bouton desktop",
      "min": 40,
      "max": 90,
      "step": 2,
      "default": 56,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "button_height_mobile",
      "label": "Hauteur bouton mobile",
      "min": 40,
      "max": 90,
      "step": 2,
      "default": 54,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "button_padding_x_desktop",
      "label": "Padding horizontal bouton",
      "min": 10,
      "max": 70,
      "step": 2,
      "default": 36,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Arrondi bouton",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "button_margin_top",
      "label": "Espace au-dessus du bouton desktop",
      "min": 10,
      "max": 80,
      "step": 2,
      "default": 38,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "button_margin_top_mobile",
      "label": "Espace au-dessus du bouton mobile",
      "min": 8,
      "max": 80,
      "step": 2,
      "default": 22,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Dimensions desktop"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Largeur maximale",
      "min": 900,
      "max": 1600,
