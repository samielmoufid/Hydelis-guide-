{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign is_car = false
  if s.mode == 'carrousel'
    assign is_car = true
  endif
-%}

<div class="vgr{% if is_car %} vgr--car{% endif %}" id="vgr-{{ sid }}"{% if s.reveal %} data-vgr-reveal{% endif %}>
  <div class="vgr__wrap">

    <div class="vgr__head" data-vgr-el>
      {%- if s.eyebrow != blank -%}
        <div class="vgr__eyebrow"><span class="vgr__hair"></span>{{ s.eyebrow }}</div>
      {%- endif -%}
      {%- if s.title != blank -%}
        <h2 class="vgr__title">{{ s.title }}{% if s.title_accent != blank %} <em>{{ s.title_accent }}</em>{% endif %}</h2>
      {%- endif -%}
      {%- if s.intro != blank -%}<p class="vgr__intro">{{ s.intro }}</p>{%- endif -%}
    </div>

    <div class="vgr__rail" data-vgr-el>
      <div class="vgr__grid{% if is_car %} vgr__track{% endif %}"{% if is_car %} data-vgr-track tabindex="0" role="group" aria-label="{{ s.title | default: 'Sélection' | escape }}"{% endif %}>
        {%- for block in section.blocks -%}
          {%- if block.type == 'carte' -%}
            {%- liquid
              assign col = block.settings.collection
              assign nom = block.settings.title
              if nom == blank and col != blank
                assign nom = col.title
              endif
              assign lien = block.settings.link
              if lien == blank and col != blank
                assign lien = col.url
              endif
              assign visuel = block.settings.image
              if s.visuel_mode != 'illu'
                if visuel == blank and col != blank
                  assign visuel = col.image
                endif
                if visuel == blank and col != blank
                  assign visuel = col.products.first.featured_image
                endif
              endif
              assign illu_key = nom | downcase
              if col != blank
                assign illu_key = col.handle
              endif
            -%}
            <a class="vgr__card{% if s.tilt %} is-tilt{% endif %}" href="{{ lien | default: '#' }}" data-vgr-card {{ block.shopify_attributes }}>
              <div class="vgr__inner" data-vgr-inner>
                <div class="vgr__media">
                  {%- if visuel != blank -%}
                    {{ visuel | image_url: width: 900 | image_tag:
                         loading: 'lazy',
                         sizes: '(min-width: 990px) 25vw, 46vw',
                         widths: '300,400,600,800,900',
                         alt: nom,
                         class: 'vgr__img' }}
                  {%- else -%}
                    {%- render 'velluce-illus', key: illu_key, uid: block.id, name: nom -%}
                  {%- endif -%}
                  {%- if s.glow -%}<span class="vgr__glow" data-vgr-glow aria-hidden="true"></span>{%- endif -%}
                  <span class="vgr__edge" aria-hidden="true"></span>
                </div>
                <div class="vgr__plate">
                  <span class="vgr__plate-t">{{ nom }}</span>
                  {%- if s.show_count and col != blank -%}
                    <span class="vgr__plate-n">{{ col.all_products_count }}</span>
                  {%- endif -%}
                </div>
              </div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if is_car and s.show_arrows -%}
        <button class="vgr__nav vgr__nav--prev" type="button" data-vgr-prev aria-label="Voir les précédents" hidden>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M14.5 5.5 8 12l6.5 6.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button class="vgr__nav vgr__nav--next" type="button" data-vgr-next aria-label="Voir les suivants" hidden>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9.5 5.5 16 12l-6.5 6.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      {%- endif -%}
    </div>

    {%- if is_car and s.show_dots -%}
      <div class="vgr__dots" data-vgr-dots role="tablist" aria-label="Pagination"></div>
    {%- endif -%}

    {%- if s.cta_label != blank and s.cta_link != blank -%}
      <div class="vgr__cta" data-vgr-el>
        <a class="vgr__link" href="{{ s.cta_link }}">
          {{ s.cta_label }}
          <svg viewBox="0 0 26 8" fill="none" aria-hidden="true"><path d="M0 4h24M21 1l3.2 3L21 7" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    {%- endif -%}

  </div>
</div>

<style>
  #vgr-{{ sid }}{
    --acc:{{ s.accent }}; --ink:{{ s.ink }}; --muted:{{ s.muted }};
    --rule:{{ s.rule_color }}; --snow:{{ s.frame_color }}; --gold:{{ s.gold }};
    --dot:{{ s.dot_color }}; --gap:{{ s.gap }}px; --pv:{{ s.per_view }};
    background:{{ s.bg }}; padding:{{ s.pad_top }}px 24px {{ s.pad_bottom }}px;
  }
  #vgr-{{ sid }} .vgr__wrap{ max-width:{{ s.max_width }}px; margin:0 auto; }

  #vgr-{{ sid }} .vgr__head{ text-align:{{ s.align }}; margin:0 0 {{ s.head_gap }}px; }
  #vgr-{{ sid }} .vgr__eyebrow{
    display:flex; align-items:center; gap:13px; margin:0 0 16px;
    {% if s.align == 'center' %}justify-content:center;{% endif %}
    font-size:10.5px; font-weight:700; letter-spacing:.26em; text-transform:uppercase; color:var(--gold);
  }
  #vgr-{{ sid }} .vgr__hair{ width:36px; height:1px; background:var(--acc); flex:none; }
  #vgr-{{ sid }} .vgr__title{
    margin:0; color:var(--ink); font-weight:400;
    font-size:clamp(26px,3.6vw,{{ s.title_size }}px); line-height:1.1; letter-spacing:-.025em;
  }
  #vgr-{{ sid }} .vgr__title em{ font-style:italic; color:var(--acc); }
  #vgr-{{ sid }} .vgr__intro{
    margin:14px auto 0; max-width:60ch; font-size:15.5px; line-height:1.65; color:var(--muted);
    {% if s.align != 'center' %}margin-left:0;{% endif %}
  }

  #vgr-{{ sid }} .vgr__rail{ position:relative; }
  #vgr-{{ sid }} .vgr__grid{
    display:grid; grid-template-columns:repeat({{ s.cols }}, minmax(0,1fr)); gap:{{ s.gap }}px;
  }

  /* --- carrousel --- */
  #vgr-{{ sid }} .vgr__track{
    display:flex; flex-wrap:nowrap; gap:var(--gap);
    overflow-x:auto; overflow-y:hidden;
    scroll-snap-type:x mandatory; scroll-behavior:smooth; overscroll-behavior-x:contain;
    scrollbar-width:none; -ms-overflow-style:none;
    padding:8px 2px 18px; margin:-8px -2px -18px;
  }
  #vgr-{{ sid }} .vgr__track::-webkit-scrollbar{ display:none; }
  #vgr-{{ sid }} .vgr__track:focus-visible{ outline:1px solid var(--acc); outline-offset:6px; }
  #vgr-{{ sid }} .vgr__track > .vgr__card{
    flex:0 0 calc((100% - (var(--pv) - 1) * var(--gap)) / var(--pv));
    scroll-snap-align:start;
  }

  #vgr-{{ sid }} .vgr__nav{
    position:absolute; top:{{ s.card_height | divided_by: 2 | plus: s.frame_pad | plus: 8 }}px;
    transform:translateY(-50%); z-index:3;
    width:46px; height:46px; padding:0; border-radius:50%;
    border:1px solid var(--rule); background:rgba(255,255,255,.94);
    -webkit-backdrop-filter:blur(6px); backdrop-filter:blur(6px);
    display:grid; place-items:center; cursor:pointer; color:var(--ink);
    box-shadow:0 14px 30px -18px rgba(73,57,19,.55);
    transition:opacity .35s ease, background .35s ease, border-color .35s ease;
  }
  #vgr-{{ sid }} .vgr__nav svg{ width:20px; height:20px; }
  #vgr-{{ sid }} .vgr__nav--prev{ left:-16px; }
  #vgr-{{ sid }} .vgr__nav--next{ right:-16px; }
  #vgr-{{ sid }} .vgr__nav:hover{ background:var(--snow); border-color:var(--acc); }
  #vgr-{{ sid }} .vgr__nav:disabled{ opacity:.25; cursor:default; }
  #vgr-{{ sid }} .vgr__nav[hidden]{ display:none; }

  #vgr-{{ sid }} .vgr__dots{
    display:flex; justify-content:center; align-items:center; gap:9px;
    margin-top:26px; min-height:8px;
  }
  #vgr-{{ sid }} .vgr__dots[hidden]{ display:none; }
  #vgr-{{ sid }} .vgr__dot{
    width:7px; height:7px; padding:0; border:0; border-radius:99px; cursor:pointer;
    background:var(--dot); opacity:.32;
    transition:opacity .4s ease, width .4s cubic-bezier(.2,.7,.2,1);
  }
  #vgr-{{ sid }} .vgr__dot.is-on{ opacity:1; width:24px; }

  /* --- carte --- */
  #vgr-{{ sid }} .vgr__card{ display:block; text-decoration:none; color:inherit; perspective:900px; }
  #vgr-{{ sid }} .vgr__inner{
    position:relative; background:var(--snow); padding:{{ s.frame_pad }}px;
    border-radius:{{ s.radius_out }}px; transform-style:preserve-3d; will-change:transform;
    transition:transform .65s cubic-bezier(.2,.7,.2,1), box-shadow .65s cubic-bezier(.2,.7,.2,1);
    box-shadow:0 16px 40px -26px rgba(73,57,19,.30);
  }
  #vgr-{{ sid }} .vgr__card:hover .vgr__inner{ box-shadow:0 30px 60px -28px rgba(73,57,19,.38); }
  #vgr-{{ sid }} .vgr__media{ position:relative; overflow:hidden; border-radius:{{ s.radius_in }}px; }
  #vgr-{{ sid }} .vgr__img{
    display:block; width:100%; height:{{ s.card_height }}px; object-fit:cover;
    transition:transform 1.3s cubic-bezier(.2,.7,.2,1);
  }
  #vgr-{{ sid }} .vgr__img--ph{ background:#EAF1EE; }
  #vgr-{{ sid }} .vgr__illu{
    display:block; width:100%; height:{{ s.card_height }}px;
    background:#ffffff;
    transition:transform 1.3s cubic-bezier(.2,.7,.2,1);
  }
  #vgr-{{ sid }} .vgr__card:hover .vgr__illu{ transform:scale(1.05); }
  #vgr-{{ sid }} .vgr__card:hover .vgr__img{ transform:scale(1.06); }
  #vgr-{{ sid }} .vgr__edge{
    position:absolute; inset:0; pointer-events:none; border-radius:{{ s.radius_in }}px;
    box-shadow:inset 0 0 0 1px rgba(255,255,255,.5), inset 0 0 30px 10px var(--snow);
    opacity:{{ s.edge_soft }};
  }
  #vgr-{{ sid }} .vgr__glow{
    position:absolute; inset:0; pointer-events:none; opacity:0; transition:opacity .45s ease;
    background:radial-gradient(180px circle at var(--gx,50%) var(--gy,50%), rgba(251,244,229,.36), rgba(251,244,229,0) 62%);
    mix-blend-mode:screen;
  }
  #vgr-{{ sid }} .vgr__card:hover .vgr__glow{ opacity:1; }

  #vgr-{{ sid }} .vgr__plate{
    display:flex; align-items:baseline; justify-content:space-between; gap:10px;
    padding:14px 6px 4px; transform:translateZ(22px);
  }
  #vgr-{{ sid }} .vgr__plate-t{
    color:var(--gold); font-size:{{ s.plate_size }}px; line-height:1.25; letter-spacing:-.01em;
  }
  #vgr-{{ sid }} .vgr__plate-n{
    flex:none; color:var(--muted); font-size:11px; letter-spacing:.1em;
  }

  #vgr-{{ sid }} .vgr__cta{ margin-top:{{ s.head_gap }}px; text-align:center; }
  #vgr-{{ sid }} .vgr__link{
    display:inline-flex; align-items:center; gap:12px; text-decoration:none; color:var(--ink);
    font-size:11px; font-weight:700; letter-spacing:.2em; text-transform:uppercase;
    padding-bottom:6px; border-bottom:1px solid var(--acc);
  }
  #vgr-{{ sid }} .vgr__link svg{ width:24px; height:8px; transition:transform .4s cubic-bezier(.2,.7,.2,1); }
  #vgr-{{ sid }} .vgr__link:hover svg{ transform:translateX(5px); }

  /* --- apparition --- */
  #vgr-{{ sid }}[data-vgr-reveal] [data-vgr-el]{
    opacity:0; transform:translateY(20px);
    transition:opacity .9s cubic-bezier(.2,.7,.2,1), transform .9s cubic-bezier(.2,.7,.2,1);
  }
  #vgr-{{ sid }}[data-vgr-reveal].is-in [data-vgr-el]{ opacity:1; transform:none; }
  #vgr-{{ sid }}[data-vgr-reveal].is-in .vgr__rail{ transition-delay:.1s; }
  @media (prefers-reduced-motion:reduce){
    #vgr-{{ sid }}[data-vgr-reveal] [data-vgr-el]{ opacity:1; transform:none; transition:none; }
    #vgr-{{ sid }} .vgr__img, #vgr-{{ sid }} .vgr__inner{ transition:none; }
    #vgr-{{ sid }} .vgr__track{ scroll-behavior:auto; }
  }

  @media (max-width:1360px){
    #vgr-{{ sid }} .vgr__nav--prev{ left:6px; }
    #vgr-{{ sid }} .vgr__nav--next{ right:6px; }
  }
  @media (max-width:1100px){
    #vgr-{{ sid }} .vgr__grid:not(.vgr__track){ grid-template-columns:repeat({% if s.cols > 3 %}3{% else %}{{ s.cols }}{% endif %}, minmax(0,1fr)); }
    #vgr-{{ sid }} .vgr__track{ --pv:{% if s.per_view > 3 %}3{% else %}{{ s.per_view }}{% endif %}; }
  }
  @media (max-width:989px){
    #vgr-{{ sid }} .vgr__nav{ display:none; }
  }
  @media (max-width:749px){
    #vgr-{{ sid }}{ padding:{{ s.pad_top_m }}px 16px {{ s.pad_bottom_m }}px; }
    #vgr-{{ sid }} .vgr__grid:not(.vgr__track){ grid-template-columns:repeat({{ s.cols_m }}, minmax(0,1fr)); gap:{{ s.gap_m }}px; }
    #vgr-{{ sid }} .vgr__track{ --pv:{{ s.per_view_m }}; --gap:{{ s.gap_m }}px; padding:6px 2px 14px; margin:-6px -2px -14px; }
    #vgr-{{ sid }} .vgr__title{ font-size:{{ s.title_size_m }}px; }
    #vgr-{{ sid }} .vgr__intro{ font-size:14px; }
    #vgr-{{ sid }} .vgr__head{ margin-bottom:{{ s.head_gap_m }}px; }
    #vgr-{{ sid }} .vgr__eyebrow{ font-size:9.5px; letter-spacing:.22em; margin-bottom:12px; }
    #vgr-{{ sid }} .vgr__hair{ width:24px; }
    #vgr-{{ sid }} .vgr__inner{ padding:{{ s.frame_pad_m }}px; border-radius:{{ s.radius_out_m }}px; }
    #vgr-{{ sid }} .vgr__media, #vgr-{{ sid }} .vgr__edge{ border-radius:{{ s.radius_in_m }}px; }
    #vgr-{{ sid }} .vgr__img{ height:{{ s.card_height_m }}px; }
    #vgr-{{ sid }} .vgr__illu{ height:{{ s.card_height_m }}px; }
    #vgr-{{ sid }} .vgr__plate{ padding:11px 4px 2px; transform:none; }
    #vgr-{{ sid }} .vgr__plate-t{ font-size:{{ s.plate_size_m }}px; }
    #vgr-{{ sid }} .vgr__dots{ margin-top:20px; }
  }
</style>

<script>
(function(){
  var root = document.getElementById('vgr-{{ sid }}');
  if (!root) return;

  if (root.hasAttribute('data-vgr-reveal')){
    if ('IntersectionObserver' in window){
      var io = new IntersectionObserver(function(es){
        es.forEach(function(e){ if (e.isIntersecting){ e.target.classList.add('is-in'); io.unobserve(e.target); } });
      }, { threshold: 0.1, rootMargin: '0px 0px -5% 0px' });
      io.observe(root);
    } else { root.classList.add('is-in'); }
  }

  var track = root.querySelector('[data-vgr-track]');
  if (track){
    var dots  = root.querySelector('[data-vgr-dots]');
    var prev  = root.querySelector('[data-vgr-prev]');
    var next  = root.querySelector('[data-vgr-next]');
    var pages = 0, current = -1;

    function step(){
      var card = track.querySelector('.vgr__card');
      if (!card) return track.clientWidth;
      var gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      var per = Math.max(1, Math.floor((track.clientWidth + gap) / (card.getBoundingClientRect().width + gap)));
      return per * (card.getBoundingClientRect().width + gap);
    }

    function scrollable(){ return track.scrollWidth - track.clientWidth > 4; }

    function paint(){
      var max = track.scrollWidth - track.clientWidth;
      if (prev){ prev.disabled = track.scrollLeft <= 2; }
      if (next){ next.disabled = track.scrollLeft >= max - 2; }
      if (!dots || !pages) return;
      var i = max <= 0 ? 0 : Math.round((track.scrollLeft / max) * (pages - 1));
      if (i === current) return;
      current = i;
      var kids = dots.children;
      for (var k = 0; k < kids.length; k++){
        var on = k === i;
        kids[k].classList.toggle('is-on', on);
        kids[k].setAttribute('aria-selected', on ? 'true' : 'false');
      }
    }

    function build(){
      var live = scrollable();
      if (prev) prev.hidden = !live;
      if (next) next.hidden = !live;
      if (!dots) { paint(); return; }
      dots.hidden = !live;
      if (!live){ dots.innerHTML = ''; pages = 0; current = -1; return; }
      var n = Math.max(2, Math.min(12, Math.ceil(track.scrollWidth / Math.max(1, step()))));
      if (n === pages) { current = -1; paint(); return; }
      pages = n; current = -1;
      dots.innerHTML = '';
      for (var i = 0; i < pages; i++){
        var b = document.createElement('button');
        b.type = 'button';
        b.className = 'vgr__dot';
        b.setAttribute('role', 'tab');
        b.setAttribute('aria-label', 'Aller à la vue ' + (i + 1));
        b.dataset.i = i;
        dots.appendChild(b);
      }
      paint();
    }

    dots && dots.addEventListener('click', function(ev){
      var b = ev.target.closest('.vgr__dot');
      if (!b || !pages) return;
      var max = track.scrollWidth - track.clientWidth;
      track.scrollTo({ left: (max * (parseInt(b.dataset.i, 10) / (pages - 1))) || 0, behavior: 'smooth' });
    });
    prev && prev.addEventListener('click', function(){ track.scrollBy({ left: -step(), behavior: 'smooth' }); });
    next && next.addEventListener('click', function(){ track.scrollBy({ left:  step(), behavior: 'smooth' }); });

    var ticking;
    track.addEventListener('scroll', function(){
      if (ticking) return;
      ticking = requestAnimationFrame(function(){ ticking = null; paint(); });
    }, { passive: true });

    if ('ResizeObserver' in window){
      var t;
      new ResizeObserver(function(){ clearTimeout(t); t = setTimeout(build, 140); }).observe(track);
    } else {
      window.addEventListener('resize', function(){ clearTimeout(t); t = setTimeout(build, 140); });
    }
    build();
    window.addEventListener('load', build);
  }

  if (window.matchMedia('(hover: none)').matches) return;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  var MAX = {{ s.tilt_strength }};
  root.querySelectorAll('[data-vgr-card].is-tilt').forEach(function(card){
    var inner = card.querySelector('[data-vgr-inner]');
    var glow  = card.querySelector('[data-vgr-glow]');
    if (!inner) return;
    var frame;
    card.addEventListener('pointermove', function(ev){
      if (frame) return;
      frame = requestAnimationFrame(function(){
        frame = null;
        var r = card.getBoundingClientRect();
        var px = (ev.clientX - r.left) / r.width;
        var py = (ev.clientY - r.top) / r.height;
        inner.style.transition = 'transform .16s linear, box-shadow .65s cubic-bezier(.2,.7,.2,1)';
        inner.style.transform =
          'rotateY(' + ((px - 0.5) * MAX).toFixed(2) + 'deg) rotateX(' + ((0.5 - py) * MAX).toFixed(2) + 'deg) scale(1.015)';
        if (glow){
          glow.style.setProperty('--gx', (px * 100).toFixed(1) + '%');
          glow.style.setProperty('--gy', (py * 100).toFixed(1) + '%');
        }
      });
    }, { passive: true });
    card.addEventListener('pointerleave', function(){
      inner.style.transition = 'transform .65s cubic-bezier(.2,.7,.2,1), box-shadow .65s cubic-bezier(.2,.7,.2,1)';
      inner.style.transform = '';
    }, { passive: true });
  });
})();
</script>

{% schema %}
{
  "name": "Zensea — Grille",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre",
      "default": "PAR STYLE"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Trouvez le vôtre"
    },
    {
      "type": "text",
      "id": "title_accent",
      "label": "Fin du titre (italique)"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Introduction"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alignement de l'entête",
      "options": [
        {
          "value": "left",
          "label": "À gauche"
        },
        {
          "value": "center",
          "label": "Centré"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Afficher le nombre de produits",
      "default": true
    },
    {
      "type": "header",
      "content": "Affichage"
    },
    {
      "type": "select",
      "id": "mode",
      "label": "Mode",
      "options": [
        {
          "value": "grille",
          "label": "Grille"
        },
        {
          "value": "carrousel",
          "label": "Carrousel"
        }
      ],
      "default": "grille"
    },
    {
      "type": "range",
      "id": "per_view",
      "min": 2,
      "max": 6,
      "step": 0.5,
      "label": "Cartes visibles (bureau)",
      "default": 4
    },
    {
      "type": "range",
      "id": "per_view_m",
      "min": 1,
      "max": 3,
      "step": 0.1,
      "label": "Cartes visibles (mobile)",
      "default": 1.6
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Puces de défilement",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Flèches (bureau)",
      "default": true
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Couleur des puces",
      "default": "#B4C9BE"
    },
    {
      "type": "header",
      "content": "Bouton (facultatif)"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Texte"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Lien"
    },
    {
      "type": "header",
      "content": "Grille"
    },
    {
      "type": "range",
      "id": "cols",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Colonnes (bureau)",
      "default": 4
    },
