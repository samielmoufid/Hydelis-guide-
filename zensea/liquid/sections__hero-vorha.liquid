{% liquid
  assign eyebrow = section.settings.eyebrow
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign heading_font = section.settings.heading_font
  assign text_font = section.settings.text_font
%}

{{ heading_font | font_face: font_display: 'swap' }}
{{ text_font | font_face: font_display: 'swap' }}

<section id="velluce-hero-{{ section.id }}" class="velluce-hero">
  <div class="velluce-hero__inner">
    {% if eyebrow != blank %}
      <p class="velluce-hero__eyebrow">{{ eyebrow }}</p>
    {% endif %}

    {% if heading != blank %}
      <h1 class="velluce-hero__title">{{ heading }}</h1>
    {% endif %}

    {% if subheading != blank %}
      <p class="velluce-hero__sub">{{ subheading }}</p>
    {% endif %}
  </div>
</section>

<style>
  #velluce-hero-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    min-height: {{ section.settings.section_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 24px;
    box-sizing: border-box;
    overflow: hidden;
  }

  #velluce-hero-{{ section.id }} .velluce-hero__inner {
    width: 100%;
    max-width: {{ section.settings.max_width }}px;
    text-align: center;
    transform: translateY({{ section.settings.desktop_offset }}px);
  }

  #velluce-hero-{{ section.id }} .velluce-hero__eyebrow {
    font-family: {{ text_font.family }}, {{ text_font.fallback_families }};
    font-style: {{ text_font.style }};
    font-weight: {{ text_font.weight }};
    font-size: {{ section.settings.eyebrow_size }}px;
    letter-spacing: {{ section.settings.eyebrow_spacing }}em;
    color: {{ section.settings.text_color }};
    text-transform: uppercase;
    margin: 0 0 {{ section.settings.eyebrow_margin }}px;
    line-height: 1.2;
  }

  #velluce-hero-{{ section.id }} .velluce-hero__title {
    font-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    font-style: {{ heading_font.style }};
    font-weight: {{ section.settings.heading_weight }};
    font-size: {{ section.settings.heading_size }}px;
    letter-spacing: {{ section.settings.heading_spacing }}em;
    color: {{ section.settings.text_color }};
    text-transform: uppercase;
    line-height: {{ section.settings.heading_line_height }};
    margin: 0 0 {{ section.settings.heading_margin }}px;
  }

  #velluce-hero-{{ section.id }} .velluce-hero__sub {
    font-family: {{ text_font.family }}, {{ text_font.fallback_families }};
    font-style: {{ text_font.style }};
    font-weight: {{ text_font.weight }};
    font-size: {{ section.settings.subheading_size }}px;
    letter-spacing: {{ section.settings.subheading_spacing }}em;
    color: {{ section.settings.text_color }};
    text-transform: uppercase;
    line-height: {{ section.settings.subheading_line_height }};
    margin: 0;
  }

  @media screen and (max-width: 768px) {
    #velluce-hero-{{ section.id }} {
      min-height: {{ section.settings.mobile_height }}px;
      padding: 0 {{ section.settings.mobile_side_padding }}px;
    }

    #velluce-hero-{{ section.id }} .velluce-hero__inner {
      transform: translateY({{ section.settings.mobile_offset }}px);
      max-width: 100%;
    }

    #velluce-hero-{{ section.id }} .velluce-hero__eyebrow {
      font-size: {{ section.settings.eyebrow_size_mobile }}px;
      letter-spacing: {{ section.settings.eyebrow_spacing_mobile }}em;
      margin-bottom: {{ section.settings.eyebrow_margin_mobile }}px;
    }

    #velluce-hero-{{ section.id }} .velluce-hero__title {
      font-size: {{ section.settings.heading_size_mobile }}px;
      letter-spacing: {{ section.settings.heading_spacing_mobile }}em;
      line-height: {{ section.settings.heading_line_height_mobile }};
      margin-bottom: {{ section.settings.heading_margin_mobile }}px;
      font-weight: {{ section.settings.heading_weight_mobile }};
    }

    #velluce-hero-{{ section.id }} .velluce-hero__sub {
      font-size: {{ section.settings.subheading_size_mobile }}px;
      letter-spacing: {{ section.settings.subheading_spacing_mobile }}em;
      line-height: {{ section.settings.subheading_line_height_mobile }};
      max-width: {{ section.settings.subheading_mobile_width }}px;
      margin-left: auto;
      margin-right: auto;
    }
  }
</style>

{% schema %}
{
  "name": "Hero Zensea premium",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texte supérieur",
      "default": "VELLUCE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre principal",
      "default": "LA LUMIÈRE, OUI."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sous-titre",
      "default": "MAIS SURTOUT, LA LUMIÈRE JUSTE."
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Police du titre",
      "default": "helvetica_n4"
    },
    {
      "type": "font_picker",
      "id": "text_font",
      "label": "Police description / petit texte",
      "default": "helvetica_n4"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Couleur de fond",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Couleur du texte",
      "default": "#050505"
    },
    {
      "type": "range",
      "id": "section_height",
      "label": "Hauteur desktop",
      "min": 300,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 620
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Hauteur mobile",
      "min": 260,
      "max": 700,
      "step": 10,
      "unit": "px",
      "default": 430
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Largeur maximale",
      "min": 400,
      "max": 1400,
      "step": 50,
      "unit": "px",
      "default": 1000
    },
    {
      "type": "range",
      "id": "desktop_offset",
      "label": "Position verticale desktop",
      "min": -150,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": -20
    },
    {
      "type": "range",
      "id": "mobile_offset",
      "label": "Position verticale mobile",
      "min": -150,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": -10
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "label": "Taille texte supérieur desktop",
      "min": 8,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "eyebrow_size_mobile",
      "label": "Taille texte supérieur mobile",
      "min": 8,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "eyebrow_spacing",
      "label": "Espacement lettres supérieur desktop",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0.5
    },
    {
      "type": "range",
      "id": "eyebrow_spacing_mobile",
      "label": "Espacement lettres supérieur mobile",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0.5
    },
    {
      "type": "range",
      "id": "eyebrow_margin",
      "label": "Marge sous texte supérieur desktop",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "eyebrow_margin_mobile",
      "label": "Marge sous texte supérieur mobile",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Taille titre desktop",
      "min": 30,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Taille titre mobile",
      "min": 24,
      "max": 70,
      "step": 1,
      "unit": "px",
      "default": 41
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Épaisseur titre desktop",
      "default": "300",
      "options": [
        {
          "value": "200",
          "label": "Très fin"
        },
        {
          "value": "300",
          "label": "Fin"
        },
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        }
      ]
    },
    {
      "type": "select",
      "id": "heading_weight_mobile",
      "label": "Épaisseur titre mobile",
      "default": "300",
      "options": [
        {
          "value": "200",
          "label": "Très fin"
        },
        {
          "value": "300",
          "label": "Fin"
        },
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        }
      ]
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Espacement lettres titre desktop",
      "min": -0.1,
      "max": 0.4,
      "step": 0.1,
      "default": 0
    },
    {
      "type": "range",
      "id": "heading_spacing_mobile",
      "label": "Espacement lettres titre mobile",
      "min": -0.1,
      "max": 0.4,
      "step": 0.1,
      "default": 0
    },
    {
      "type": "range",
      "id": "heading_line_height",
      "label": "Interligne titre desktop",
      "min": 0.8,
      "max": 1.5,
      "step": 0.1,
      "default": 1
    },
    {
      "type": "range",
      "id": "heading_line_height_mobile",
      "label": "Interligne titre mobile",
      "min": 0.8,
      "max": 1.5,
      "step": 0.1,
      "default": 1.1
    },
    {
      "type": "range",
      "id": "heading_margin",
      "label": "Marge sous titre desktop",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "heading_margin_mobile",
      "label": "Marge sous titre mobile",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Taille description desktop",
      "min": 8,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "subheading_size_mobile",
      "label": "Taille description mobile",
      "min": 8,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "subheading_spacing",
      "label": "Espacement lettres description desktop",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0.4
    },
    {
      "type": "range",
      "id": "subheading_spacing_mobile",
      "label": "Espacement lettres description mobile",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0.4
    },
    {
      "type": "range",
      "id": "subheading_line_height",
      "label": "Interligne description desktop",
      "min": 1,
      "max": 2,
      "step": 0.1,
      "default": 1.4
    },
    {
      "type": "range",
      "id": "subheading_line_height_mobile",
      "label": "Interligne description mobile",
      "min": 1,
      "max": 2,
      "step": 0.1,
      "default": 1.5
    },
    {
      "type": "range",
      "id": "subheading_mobile_width",
      "label": "Largeur description mobile",
      "min": 220,
      "max": 390,
      "step": 10,
      "unit": "px",
      "default": 340
    },
    {
      "type": "range",
      "id": "mobile_side_padding",
      "label": "Padding horizontal mobile",
      "min": 12,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Hero Zensea premium"
    }
  ]
}
{% endschema %}
