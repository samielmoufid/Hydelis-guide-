{% comment %}
  Section : Tout est dans le carton
  Fichier  : sections/tout-est-dans-le-carton.liquid
{% endcomment %}

{%- liquid
  assign section_id   = section.id
  assign bg_color     = section.settings.bg_color
  assign card_color   = section.settings.card_color
  assign border_color = section.settings.border_color
  assign icon_color   = section.settings.icon_color
  assign check_color  = section.settings.check_color
  assign text_color   = section.settings.text_color
  assign desc_color   = section.settings.desc_color
  assign title_size   = section.settings.title_size_desktop
  assign title_mobile = section.settings.title_size_mobile
  assign pad_top      = section.settings.padding_top
  assign pad_bot      = section.settings.padding_bottom
  assign pad_top_m    = section.settings.padding_top_mobile
  assign pad_bot_m    = section.settings.padding_bottom_mobile
  assign max_w        = section.settings.max_width
  assign radius       = section.settings.card_radius
-%}

<style>
  #tetc-{{ section_id }} {
    background-color: {{ bg_color }};
    padding-top: {{ pad_top }}px;
    padding-bottom: {{ pad_bot }}px;
    width: 100%;
    overflow: hidden;
    box-sizing: border-box;
  }

  #tetc-{{ section_id }},
  #tetc-{{ section_id }} * {
    box-sizing: border-box;
  }

  #tetc-{{ section_id }} .tetc-inner {
    max-width: {{ max_w }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  #tetc-{{ section_id }} .tetc-title {
    text-align: center;
    font-family: var(--font-body-family, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif);
    font-size: {{ title_size }}px;
    font-weight: 500;
    color: {{ text_color }};
    margin: 0 0 38px;
    line-height: 1.15;
    letter-spacing: -0.03em;
  }

  #tetc-{{ section_id }} .tetc-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  #tetc-{{ section_id }} .tetc-card {
    position: relative;
    background-color: {{ card_color }};
    border: 1.5px solid {{ border_color }};
    border-radius: {{ radius }}px;
    padding: 20px 22px;
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 104px;
  }

  #tetc-{{ section_id }} .tetc-card--highlight {
    border-color: #101211;
    border-width: 2px;
  }

  #tetc-{{ section_id }} .tetc-icon {
    flex: 0 0 auto;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    background-color: {{ icon_color }};
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #tetc-{{ section_id }} .tetc-icon svg {
    width: 16px;
    height: 16px;
    display: block;
  }

  #tetc-{{ section_id }} .tetc-content {
    flex: 1;
    min-width: 0;
  }

  #tetc-{{ section_id }} .tetc-card-title {
    font-family: var(--font-body-family, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif);
    font-size: {{ section.settings.card_title_size_desktop }}px;
    font-weight: 800;
    color: {{ text_color }};
    margin: 0 0 5px;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  #tetc-{{ section_id }} .tetc-card-desc {
    font-family: var(--font-body-family, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif);
    font-size: {{ section.settings.card_desc_size_desktop }}px;
    font-weight: 400;
    color: {{ desc_color }};
    margin: 0;
    line-height: 1.42;
  }

  /* MOBILE COMPACT — 2 PAR 2 */
  @media (max-width: 749px) {
    #tetc-{{ section_id }} {
      padding-top: {{ pad_top_m }}px;
      padding-bottom: {{ pad_bot_m }}px;
    }

    #tetc-{{ section_id }} .tetc-inner {
      padding: 0 14px;
    }

    #tetc-{{ section_id }} .tetc-title {
      font-size: {{ title_mobile }}px;
      margin-bottom: 18px;
      line-height: 1.12;
    }

    #tetc-{{ section_id }} .tetc-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 9px;
    }

    #tetc-{{ section_id }} .tetc-card {
      min-height: 108px;
      padding: 11px 10px 10px;
      border-radius: 13px;
      display: block;
    }

    #tetc-{{ section_id }} .tetc-card--highlight {
      border-width: 1.5px;
    }

    #tetc-{{ section_id }} .tetc-icon {
      position: absolute;
      top: 11px;
      left: 10px;
      width: {{ section.settings.icon_size_mobile }}px;
      height: {{ section.settings.icon_size_mobile }}px;
    }

    #tetc-{{ section_id }} .tetc-icon svg {
      width: calc({{ section.settings.icon_size_mobile }}px * 0.48);
      height: calc({{ section.settings.icon_size_mobile }}px * 0.48);
    }

    #tetc-{{ section_id }} .tetc-content {
      width: 100%;
      padding: 0;
    }

    #tetc-{{ section_id }} .tetc-card-title {
      min-height: {{ section.settings.icon_size_mobile }}px;
      display: flex;
      align-items: center;
      padding-left: calc({{ section.settings.icon_size_mobile }}px + 8px);
      font-size: {{ section.settings.card_title_size_mobile }}px;
      line-height: 1.15;
      margin: 0 0 7px;
      font-weight: 800;
      letter-spacing: -0.02em;
    }

    #tetc-{{ section_id }} .tetc-card-desc {
      font-size: {{ section.settings.card_desc_size_mobile }}px;
      line-height: 1.28;
      color: {{ desc_color }};
      display: -webkit-box;
      -webkit-line-clamp: {{ section.settings.mobile_desc_lines }};
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  }
</style>

<section id="tetc-{{ section_id }}" aria-label="{{ section.settings.title | escape }}">
  <div class="tetc-inner">

    {%- if section.settings.title != blank -%}
      <h2 class="tetc-title">{{ section.settings.title | escape }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="tetc-grid">
        {%- for block in section.blocks -%}
          <div
            class="tetc-card{% if block.settings.highlight %} tetc-card--highlight{% endif %}"
            {{ block.shopify_attributes }}
          >
            <div class="tetc-icon" aria-hidden="true">
              <svg viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M4 9.5L7.5 13L14 6" stroke="{{ check_color }}" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>

            <div class="tetc-content">
              {%- if block.settings.card_title != blank -%}
                <p class="tetc-card-title">{{ block.settings.card_title | escape }}</p>
              {%- endif -%}

              {%- if block.settings.card_desc != blank -%}
                <p class="tetc-card-desc">{{ block.settings.card_desc | escape }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
