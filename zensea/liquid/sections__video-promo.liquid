{% comment %} Velluce - Video promo (texte centre) {% endcomment %}
{%- liquid
  assign h = section.settings.height | default: 70
  assign hm = section.settings.height_mobile | default: 80
-%}
<section
  id="bbvideo-{{ section.id }}"
  class="bbvideo"
  style="
    --bb-h: {{ h }}vh;
    --bb-h-mobile: {{ hm }}vh;
    --bb-overlay: {{ section.settings.overlay_opacity }};
    --bb-overlay-color: {{ section.settings.overlay_color }};
    --bb-text: {{ section.settings.text_color }};
    --bb-accent: {{ section.settings.accent_color }};
    --bb-maxw: {{ section.settings.content_max_width }}px;
  "
>
  <div class="bbvideo__media">
  <div class="bbvideo__layer bbvideo__layer--desktop">
    {%- if section.settings.video_desktop != blank -%}{{ section.settings.video_desktop | video_tag: image_size: '1600x', autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'bbvideo__el' }}
    {%- elsif section.settings.video_url_desktop != blank -%}<video class="bbvideo__el" autoplay muted loop playsinline preload="auto" {% if section.settings.poster_desktop != blank %}poster="{{ section.settings.poster_desktop | image_url: width: 1600 }}"{% endif %}><source src="{{ section.settings.video_url_desktop }}" type="video/mp4"></video>
    {%- elsif section.settings.poster_desktop != blank -%}<img class="bbvideo__el" src="{{ section.settings.poster_desktop | image_url: width: 1600 }}" alt="{{ section.settings.title | escape }}" loading="lazy">
    {%- elsif section.settings.video != blank -%}{{ section.settings.video | video_tag: image_size: '1600x', autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'bbvideo__el' }}
    {%- elsif section.settings.video_url != blank -%}<video class="bbvideo__el" autoplay muted loop playsinline preload="auto" {% if section.settings.poster != blank %}poster="{{ section.settings.poster | image_url: width: 1600 }}"{% endif %}><source src="{{ section.settings.video_url }}" type="video/mp4"></video>
    {%- elsif section.settings.poster != blank -%}<img class="bbvideo__el" src="{{ section.settings.poster | image_url: width: 1600 }}" alt="{{ section.settings.title | escape }}" loading="lazy">
    {%- else -%}<div class="bbvideo__el bbvideo__placeholder">{%- render 'velluce-illus', key: 'guide', uid: section.id, name: 'Zensea' -%}</div>{%- endif -%}
  </div>
  <div class="bbvideo__layer bbvideo__layer--mobile">
    {%- if section.settings.video != blank -%}{{ section.settings.video | video_tag: image_size: '1080x', autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'bbvideo__el' }}
    {%- elsif section.settings.video_url != blank -%}<video class="bbvideo__el" autoplay muted loop playsinline preload="auto" {% if section.settings.poster != blank %}poster="{{ section.settings.poster | image_url: width: 1080 }}"{% endif %}><source src="{{ section.settings.video_url }}" type="video/mp4"></video>
    {%- elsif section.settings.poster != blank -%}<img class="bbvideo__el" src="{{ section.settings.poster | image_url: width: 1080 }}" alt="{{ section.settings.title | escape }}" loading="lazy">
    {%- elsif section.settings.video_desktop != blank -%}{{ section.settings.video_desktop | video_tag: image_size: '1080x', autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'bbvideo__el' }}
    {%- elsif section.settings.video_url_desktop != blank -%}<video class="bbvideo__el" autoplay muted loop playsinline preload="auto"><source src="{{ section.settings.video_url_desktop }}" type="video/mp4"></video>
    {%- elsif section.settings.poster_desktop != blank -%}<img class="bbvideo__el" src="{{ section.settings.poster_desktop | image_url: width: 1080 }}" alt="{{ section.settings.title | escape }}" loading="lazy">
    {%- else -%}<div class="bbvideo__el bbvideo__placeholder">{%- render 'velluce-illus', key: 'guide', uid: section.id, name: 'Zensea' -%}</div>{%- endif -%}
  </div>
  <div class="bbvideo__overlay"></div>
</div>

  <div class="bbvideo__content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="bbvideo__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.title != blank -%}
      <h2 class="bbvideo__title">{{ section.settings.title }}</h2>
    {%- endif -%}
    {%- if section.settings.subtitle != blank -%}
      <p class="bbvideo__subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="bbvideo__btn" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</section>

<style>
  #bbvideo-{{ section.id }}.bbvideo{position:relative;width:100%;height:var(--bb-h);min-height:340px;overflow:hidden;display:flex;align-items:flex-end;justify-content:center;text-align:center;padding-bottom:7vh;}
  #bbvideo-{{ section.id }} .bbvideo__media{position:absolute;inset:0;z-index:0;}
  #bbvideo-{{ section.id }} .bbvideo__layer{position:absolute;inset:0;}
  #bbvideo-{{ section.id }} .bbvideo__layer--mobile{display:none;}
  #bbvideo-{{ section.id }} .bbvideo__layer--desktop{display:block;}
  #bbvideo-{{ section.id }} .bbvideo__el{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;}
  #bbvideo-{{ section.id }} .bbvideo__placeholder svg{width:100%;height:100%;object-fit:cover;}
  #bbvideo-{{ section.id }} .bbvideo__overlay{position:absolute;inset:0;background:linear-gradient(to top, var(--bb-overlay-color) 0%, rgba(0,0,0,0) 62%);opacity:calc(var(--bb-overlay)/100);}
  #bbvideo-{{ section.id }} .bbvideo__content{position:relative;z-index:2;max-width:var(--bb-maxw);padding:0 24px;color:var(--bb-text);width:100%;}
  #bbvideo-{{ section.id }} .bbvideo__eyebrow{margin:0 0 14px;font-size:13px;letter-spacing:.18em;text-transform:uppercase;font-weight:600;color:var(--bb-accent);text-shadow:0 1px 12px rgba(0,0,0,.55);}
  #bbvideo-{{ section.id }} .bbvideo__title{margin:0;font-size:{{ section.settings.title_size }}px;line-height:1.08;font-weight:700;letter-spacing:-.02em;color:var(--bb-text);text-shadow:0 2px 24px rgba(0,0,0,.6),0 1px 4px rgba(0,0,0,.5);}
  #bbvideo-{{ section.id }} .bbvideo__subtitle{margin:18px auto 0;max-width:600px;font-size:{{ section.settings.subtitle_size }}px;line-height:1.55;font-weight:400;opacity:1;text-shadow:0 2px 18px rgba(0,0,0,.6);}
  #bbvideo-{{ section.id }} .bbvideo__btn{display:inline-flex;align-items:center;justify-content:center;margin-top:30px;padding:0 38px;min-height:56px;border-radius:{{ section.settings.button_radius }}px;background:{{ section.settings.button_bg }};color:{{ section.settings.button_text_color }};font-size:15px;font-weight:600;letter-spacing:.02em;text-decoration:none;transition:transform .2s ease,opacity .2s ease;}
  #bbvideo-{{ section.id }} .bbvideo__btn:hover{transform:translateY(-2px);opacity:.92;}
  @media (max-width:749px){
    #bbvideo-{{ section.id }}.bbvideo{height:var(--bb-h-mobile);}
    #bbvideo-{{ section.id }} .bbvideo__layer--mobile{display:block;}
    #bbvideo-{{ section.id }} .bbvideo__layer--desktop{display:none;}
    #bbvideo-{{ section.id }} .bbvideo__title{font-size:{{ section.settings.title_size_mobile }}px;}
    #bbvideo-{{ section.id }} .bbvideo__subtitle{font-size:{{ section.settings.subtitle_size_mobile }}px;}
    #bbvideo-{{ section.id }} .bbvideo__btn{width:100%;max-width:360px;}
  }
</style>

{% schema %}
{
  "name": "Zensea Video promo",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Vidéo — Mobile (celle actuelle)"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Vidéo (fichier Shopify)"
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "OU lien vidéo .mp4",
      "info": "Utilisé si aucune vidéo Shopify n'est choisie"
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Image de secours / poster (mobile)"
    },
    {
      "type": "header",
      "content": "Vidéo — Ordinateur (desktop)"
    },
    {
      "type": "video",
      "id": "video_desktop",
      "label": "Vidéo desktop (fichier Shopify)"
    },
    {
      "type": "url",
      "id": "video_url_desktop",
      "label": "OU lien vidéo .mp4 (desktop)"
    },
    {
      "type": "image_picker",
      "id": "poster_desktop",
      "label": "Image de secours / poster (desktop)"
    },
    {
      "type": "header",
      "content": "Superposition"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Couleur du voile",
      "default": "#292F2C"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Opacité du dégradé bas (%)",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 35,
      "unit": "%"
    },
    {
      "type": "header",
      "content": "Texte"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre",
      "default": "OFFRE LIMITÉE"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Prix réduits sur toute la boutique"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "Profitez-en pour sublimer votre intérieur, pour une durée limitée."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Couleur du texte",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Couleur du sur-titre",
      "default": "#B4C9BE"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Taille titre desktop",
      "min": 28,
      "max": 80,
      "step": 2,
      "default": 52,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "label": "Taille titre mobile",
      "min": 22,
      "max": 56,
      "step": 2,
      "default": 32,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "label": "Taille sous-titre desktop",
      "min": 14,
      "max": 28,
      "step": 1,
      "default": 18,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "subtitle_size_mobile",
      "label": "Taille sous-titre mobile",
      "min": 13,
      "max": 22,
      "step": 1,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Bouton"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texte du bouton",
      "default": "J'en profite"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien du bouton"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Fond du bouton",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Texte du bouton",
      "default": "#292F2C"
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Arrondi du bouton",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 30,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Dimensions"
    },
    {
      "type": "range",
      "id": "height",
      "label": "Hauteur desktop",
      "min": 40,
      "max": 100,
      "step": 5,
      "default": 70,
      "unit": "vh"
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Hauteur mobile",
      "min": 40,
      "max": 100,
      "step": 5,
      "default": 75,
      "unit": "vh"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Largeur max du texte",
      "min": 400,
      "max": 1000,
      "step": 20,
      "default": 720,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Zensea Video promo"
    }
  ]
}
{% endschema %}