{% comment %}
  Section : Image texte premium Velluce
{% endcomment %}

<style>
  #hyd-itp-{{ section.id }} {
    background: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #hyd-itp-{{ section.id }} * {
    box-sizing: border-box;
  }

  #hyd-itp-{{ section.id }} .hyd-itp__inner {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: {{ section.settings.desktop_gap }}px;
  }

  #hyd-itp-{{ section.id }} .hyd-itp__inner--reverse {
    flex-direction: row-reverse;
  }

  #hyd-itp-{{ section.id }} .hyd-itp__text-col {
    flex: 0 0 {{ section.settings.text_width_desktop }}%;
    min-height: {{ section.settings.text_height_desktop }}px;
    background: {{ section.settings.text_bg_color }};
    border-radius: {{ section.settings.text_radius }}px;
    padding: {{ section.settings.text_padding }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: visible;
  }

  #hyd-itp-{{ section.id }} .hyd-itp__text-inner {
    width: 100%;
    max-width: {{ section.settings.text_max_width }}px;
    margin: 0 auto;
    text-align: center;
    overflow: visible;
  }

  #hyd-itp-{{ section.id }} .hyd-itp__title {
    font-family: {{ section.settings.title_font }};
    font-size: {{ section.settings.title_size_desktop }}px;
    font-weight: {{ section.settings.title_weight }};
    color: {{ section.settings.title_color }};
    line-height: 1.08;
    letter-spacing: -0.8px;
    margin: 0 auto {{ section.settings.title_margin_bottom }}px;
    max-width: 100%;
    text-align: center;

    display: block;
    white-space: normal;
    overflow: visible;
    text-overflow: unset;
    word-break: normal;
    overflow-wrap: normal;
    -webkit-line-clamp: unset;
    -webkit-box-orient: initial;
  }

  #hyd-itp-{{ section.id }} .hyd-itp__body {
    font-family: {{ section.settings.text_font }};
    font-size: {{ section.settings.text_size_desktop }}px;
    font-weight: {{ section.settings.text_weight }};
    color: {{ section.settings.text_color }};
    line-height: {{ section.settings.text_line_height }};
    margin: 0 auto {{ section.settings.text_margin_bottom }}px;
    max-width: {{ section.settings.text_max_width }}px;
    text-align: center;
  }

  #hyd-itp-{{ section.id }} .hyd-itp__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: {{ section.settings.btn_color }};
    color: {{ section.settings.btn_text_color }};
    font-family: {{ section.settings.button_font }};
    font-size: {{ section.settings.btn_size }}px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    padding: {{ section.settings.btn_padding_y }}px {{ section.settings.btn_padding_x }}px;
    border-radius: {{ section.settings.btn_radius }}px;
    text-align: center;
    margin: 0 auto;
  }

  #hyd-itp-{{ section.id }} .hyd-itp__img-col {
    flex: 0 0 {{ section.settings.image_width_desktop }}%;
    height: {{ section.settings.img_height_desktop }}px;
    border-radius: {{ section.settings.img_radius }}px;
    overflow: hidden;
    background: #DEE2E0;
  }

  #hyd-itp-{{ section.id }} .hyd-itp__img-col img,
  #hyd-itp-{{ section.id }} .hyd-itp__img-placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: {{ section.settings.img_radius }}px;
  }

  #hyd-itp-{{ section.id }} .hyd-itp__img-placeholder {
    background: #DCE0DE;
  }

  @media (max-width: 768px) {
    #hyd-itp-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    #hyd-itp-{{ section.id }} .hyd-itp__inner,
    #hyd-itp-{{ section.id }} .hyd-itp__inner--reverse {
      flex-direction: column;
      align-items: stretch;
      justify-content: center;
      gap: 0;
      padding-left: {{ section.settings.mobile_margin }}px;
      padding-right: {{ section.settings.mobile_margin }}px;
      width: 100%;
    }

    #hyd-itp-{{ section.id }} .hyd-itp__img-col {
      order: 1;
      width: 100%;
      flex: none;
      height: {{ section.settings.img_height_mobile }}px;
      border-radius: {{ section.settings.img_radius_mobile }}px {{ section.settings.img_radius_mobile }}px 0 0;
    }

    #hyd-itp-{{ section.id }} .hyd-itp__img-col img,
    #hyd-itp-{{ section.id }} .hyd-itp__img-placeholder {
      border-radius: {{ section.settings.img_radius_mobile }}px {{ section.settings.img_radius_mobile }}px 0 0;
    }

    #hyd-itp-{{ section.id }} .hyd-itp__text-col {
      order: 2;
      width: 100%;
      flex: none;
      min-height: auto;
      padding: {{ section.settings.text_padding_mobile }}px;
      border-radius: 0 0 {{ section.settings.img_radius_mobile }}px {{ section.settings.img_radius_mobile }}px;

      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      overflow: visible;
    }

    #hyd-itp-{{ section.id }} .hyd-itp__text-inner {
      width: 100%;
      max-width: 100%;
      margin: 0 auto;
      text-align: center;
      overflow: visible;
    }

    #hyd-itp-{{ section.id }} .hyd-itp__title {
      font-size: clamp(24px, 7.4vw, {{ section.settings.title_size_mobile }}px);
      line-height: 1.08;
      letter-spacing: -0.7px;
      margin: 0 auto {{ section.settings.title_margin_bottom_mobile }}px;
      max-width: 100%;
      text-align: center;

      display: block;
      white-space: normal;
      overflow: visible;
      text-overflow: unset;
      word-break: normal;
      overflow-wrap: normal;
      -webkit-line-clamp: unset;
      -webkit-box-orient: initial;
    }

    #hyd-itp-{{ section.id }} .hyd-itp__body {
      font-size: {{ section.settings.text_size_mobile }}px;
      line-height: 1.55;
      margin: 0 auto {{ section.settings.text_margin_bottom_mobile }}px;
      max-width: 100%;
      text-align: center;
    }

    #hyd-itp-{{ section.id }} .hyd-itp__btn {
      display: flex;
      width: 100%;
      text-align: center;
      padding: {{ section.settings.btn_padding_y_mobile }}px 18px;
    }
  }

  @media (max-width: 390px) {
    #hyd-itp-{{ section.id }} .hyd-itp__title {
      font-size: clamp(22px, 7vw, 30px);
      line-height: 1.1;
    }

    #hyd-itp-{{ section.id }} .hyd-itp__body {
      font-size: {{ section.settings.text_size_mobile | minus: 1 }}px;
    }
  }
</style>

<section class="hyd-itp" id="hyd-itp-{{ section.id }}">
  <div class="hyd-itp__inner{% if section.settings.img_position == 'left' %} hyd-itp__inner--reverse{% endif %}">

    <div class="hyd-itp__text-col">
      <div class="hyd-itp__text-inner">

        {% if section.settings.title != blank %}
          <h2 class="hyd-itp__title">
            {{ section.settings.title | escape }}
          </h2>
        {% endif %}

        {% if section.settings.text != blank %}
          <div class="hyd-itp__body">
            {{ section.settings.text | newline_to_br }}
          </div>
        {% endif %}

        {% if section.settings.btn_label != blank %}
          <a class="hyd-itp__btn" href="{{ section.settings.btn_link | default: '#' }}">
            {{ section.settings.btn_label | escape }}
          </a>
        {% endif %}

      </div>
    </div>

    <div class="hyd-itp__img-col">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1600
          | image_tag:
            loading: 'lazy',
            alt: section.settings.image.alt | default: section.settings.title
        }}
      {% else %}
        <div class="hyd-itp__img-placeholder"></div>
      {% endif %}
    </div>

  </div>
</section>

