{% comment %}
  Velluce — Expérience 3D & réalité augmentée (v2, carte immersive)
  Sous la galerie produit : le luminaire tourne en 3D DANS la carte
  (viseur holographique), bouton vers le plein écran + « Voir chez vous »
  en RA à taille réelle (pose plafond simulée à 2,40 m, ancrage sol).
  Ne s'affiche que si le produit possède un modèle 3D.
{% endcomment %}

{%- assign v3d_model = product.media | where: 'media_type', 'model' | first -%}
{%- if v3d_model -%}
{%- assign v3d_glb = v3d_model.sources | where: 'format', 'glb' | first -%}
{%- assign v3d_usdz = v3d_model.sources | where: 'format', 'usdz' | first -%}

<section class="v3d" id="v3d-{{ section.id }}">
  <div class="v3d-card">
    <div class="v3d-stage" data-v3d-open role="button" tabindex="0" aria-label="Ouvrir {{ product.title | escape }} en 3D plein écran">
      <div class="v3d-corners" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
      <model-viewer class="v3d-mini"
        src="{{ v3d_glb.url }}"
        alt="{{ product.title | escape }} en 3D"
        auto-rotate auto-rotate-delay="0" rotation-per-second="18deg"
        camera-target="0m 1.75m 0m" camera-orbit="20deg 78deg 2.5m"
        disable-zoom disable-pan disable-tap interaction-prompt="none"
        shadow-intensity="0.6" exposure="1.1" loading="lazy" reveal="auto"></model-viewer>
      <div class="v3d-halo" aria-hidden="true"></div>
      <span class="v3d-live"><i></i>Aperçu 3D en direct</span>
    </div>
    <div class="v3d-copy">
      <span class="v3d-badge">{{ section.settings.badge }}</span>
      <h3 class="v3d-title">{{ section.settings.titre }}</h3>
      <p class="v3d-text">{{ section.settings.texte }}</p>
      <button type="button" class="v3d-cta" data-v3d-open>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M3 9V5.5A2.5 2.5 0 0 1 5.5 3H9M15 3h3.5A2.5 2.5 0 0 1 21 5.5V9M21 15v3.5a2.5 2.5 0 0 1-2.5 2.5H15M9 21H5.5A2.5 2.5 0 0 1 3 18.5V15"/><path d="M12 7.5l4.5 2.6v5.2L12 17.9l-4.5-2.6V10.1L12 7.5z"/></svg>
        <span>{{ section.settings.bouton }}</span>
      </button>
      <p class="v3d-note">{{ section.settings.note }}</p>
    </div>
  </div>

  <div class="v3d-modal" data-v3d-modal hidden role="dialog" aria-modal="true" aria-label="{{ product.title | escape }} en 3D">
    <div class="v3d-modal-backdrop" data-v3d-close></div>
    <div class="v3d-modal-panel">
      <div class="v3d-modal-head">
        <span class="v3d-modal-title">{{ product.title | escape }}</span>
        <button type="button" class="v3d-x" data-v3d-close aria-label="Fermer">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>
      <model-viewer class="v3d-full"
        src="{{ v3d_glb.url }}"
        {% if v3d_usdz %}ios-src="{{ v3d_usdz.url }}"{% endif %}
        alt="{{ product.title | escape }} en 3D"
        camera-controls auto-rotate auto-rotate-delay="1200" rotation-per-second="20deg"
        camera-target="0m 1.7m 0m" camera-orbit="25deg 75deg 2.8m" min-camera-orbit="auto auto 1.2m" max-camera-orbit="auto auto 4.5m"
        ar ar-modes="scene-viewer quick-look webxr" ar-scale="fixed" ar-placement="floor"
        shadow-intensity="1" exposure="1.05" interaction-prompt="none"
        loading="eager" reveal="auto">
        <button slot="ar-button" class="v3d-ar-btn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M3 9V5.5A2.5 2.5 0 0 1 5.5 3H9M15 3h3.5A2.5 2.5 0 0 1 21 5.5V9M21 15v3.5a2.5 2.5 0 0 1-2.5 2.5H15M9 21H5.5A2.5 2.5 0 0 1 3 18.5V15"/><path d="M12 8l4 2.3v4.5L12 17l-4-2.2V10.3L12 8z"/></svg>
          Voir chez vous
        </button>
      </model-viewer>
      <div class="v3d-legend">
        <span class="v3d-dim">{{ section.settings.mention_dimensions }}</span>
        <span class="v3d-hint">Tournez du doigt · Pincez pour zoomer</span>
      </div>
    </div>
  </div>
</section>

<style>
  #v3d-{{ section.id }} { margin: 30px auto; padding: 0 15px; max-width: 1200px; }
  .v3d-card { position: relative; display: grid; grid-template-columns: minmax(260px, 5fr) 7fr;
    gap: 0; overflow: hidden; border-radius: 20px;
    background:
      radial-gradient(90% 120% at 15% 0%, rgba(207,161,74,0.12) 0%, transparent 55%),
      linear-gradient(150deg, #171512 0%, #221d16 55%, #151210 100%);
    border: 1px solid rgba(207,161,74,0.38);
    box-shadow: 0 24px 60px rgba(0,0,0,0.35), inset 0 1px 0 rgba(255,255,255,0.05); }
  @media (max-width: 749px) { .v3d-card { grid-template-columns: 1fr; } }

  /* — Scène miniature (viseur holographique) — */
  .v3d-stage { position: relative; min-height: 300px; cursor: pointer; outline: none;
    background:
      linear-gradient(rgba(207,161,74,0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(207,161,74,0.05) 1px, transparent 1px),
      radial-gradient(120% 90% at 50% 30%, #2b251d 0%, #17140f 75%);
    background-size: 34px 34px, 34px 34px, 100% 100%; }
  .v3d-stage:focus-visible { box-shadow: inset 0 0 0 2px #cfa14a; }
  .v3d-mini { position: absolute; inset: 0; width: 100%; height: 100%; --poster-color: transparent; pointer-events: none; }
  .v3d-halo { position: absolute; left: 50%; bottom: 12%; width: 62%; height: 30px;
    transform: translateX(-50%); border-radius: 50%;
    background: radial-gradient(ellipse, rgba(207,161,74,0.28) 0%, transparent 70%);
    filter: none; animation: v3d-pulse 3.2s ease-in-out infinite; pointer-events: none; }
  @keyframes v3d-pulse { 0%, 100% { opacity: 0.5; } 50% { opacity: 1; } }
  .v3d-corners { position: absolute; inset: 14px; pointer-events: none; }
  .v3d-corners i { position: absolute; width: 22px; height: 22px; border: 1.5px solid rgba(207,161,74,0.8); }
  .v3d-corners i:nth-child(1) { top: 0; left: 0; border-right: 0; border-bottom: 0; border-radius: 6px 0 0 0; }
  .v3d-corners i:nth-child(2) { top: 0; right: 0; border-left: 0; border-bottom: 0; border-radius: 0 6px 0 0; }
  .v3d-corners i:nth-child(3) { bottom: 0; left: 0; border-right: 0; border-top: 0; border-radius: 0 0 0 6px; }
  .v3d-corners i:nth-child(4) { bottom: 0; right: 0; border-left: 0; border-top: 0; border-radius: 0 0 6px 0; }
  .v3d-live { position: absolute; top: 22px; left: 50%; transform: translateX(-50%);
    display: inline-flex; align-items: center; gap: 7px; white-space: nowrap;
    color: #e8d9b8; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; }
  .v3d-live i { width: 7px; height: 7px; border-radius: 50%; background: #cfa14a;
    box-shadow: 0 0 8px 2px rgba(207,161,74,0.7); animation: v3d-pulse 1.8s ease-in-out infinite; }

  /* — Texte — */
  .v3d-copy { padding: 30px 28px 26px; display: flex; flex-direction: column; align-items: flex-start; }
  .v3d-badge { display: inline-block; background: linear-gradient(100deg, #cfa14a, #e5c375);
    color: #1c1a17; font-size: 10.5px; font-weight: 700; letter-spacing: 0.16em;
    text-transform: uppercase; padding: 6px 14px; border-radius: 999px; margin-bottom: 14px; }
  .v3d-title { font-size: clamp(22px, 4.5vw, 30px); line-height: 1.15; margin: 0 0 10px;
    font-weight: 650; color: #fff; }
  .v3d-text { margin: 0 0 20px; font-size: 15px; line-height: 1.6; color: #d8cdbb; max-width: 52ch; }
  .v3d-cta { display: inline-flex; align-items: center; gap: 11px; cursor: pointer;
    background: linear-gradient(100deg, #cfa14a, #e0bb66); color: #211c14; border: 0;
    border-radius: 999px; font-size: 15.5px; font-weight: 700; padding: 16px 30px;
    box-shadow: 0 6px 22px rgba(207,161,74,0.28);
    transition: transform 0.2s, box-shadow 0.2s; }
  .v3d-cta:hover { transform: translateY(-2px); box-shadow: 0 10px 30px rgba(207,161,74,0.42); }
  .v3d-cta svg { width: 20px; height: 20px; }
  .v3d-note { margin: 13px 0 0; font-size: 12.5px; color: #a2957f; }

  /* — Plein écran — */
  .v3d-modal { position: fixed; inset: 0; z-index: 999; display: flex; align-items: center; justify-content: center; }
  .v3d-modal[hidden] { display: none; }
  .v3d-modal-backdrop { position: absolute; inset: 0; background: rgba(10, 8, 6, 0.85); }
  .v3d-modal-panel { position: relative; width: min(94vw, 680px); height: min(88vh, 760px);
    display: flex; flex-direction: column; background: #1c1813; border-radius: 20px;
    border: 1px solid rgba(207,161,74,0.32); overflow: hidden; }
  .v3d-modal-head { display: flex; align-items: center; justify-content: space-between;
    padding: 14px 18px; border-bottom: 1px solid rgba(207,161,74,0.16); }
  .v3d-modal-title { color: #f4ede1; font-weight: 600; font-size: 15px; }
  .v3d-x { background: none; border: 0; color: #cfa14a; cursor: pointer; padding: 6px; }
  .v3d-x svg { width: 20px; height: 20px; }
  .v3d-full { flex: 1; width: 100%; --poster-color: transparent;
    background: radial-gradient(120% 100% at 50% 20%, #322b22 0%, #1c1813 72%); }
  .v3d-ar-btn { position: absolute; bottom: 16px; left: 50%; transform: translateX(-50%);
    display: inline-flex; align-items: center; gap: 9px;
    background: linear-gradient(100deg, #cfa14a, #e0bb66); color: #211c14;
    border: 0; border-radius: 999px; font-weight: 700; font-size: 14.5px;
    padding: 14px 26px; cursor: pointer; box-shadow: 0 6px 20px rgba(0,0,0,0.4); }
  .v3d-ar-btn svg { width: 18px; height: 18px; }
  .v3d-legend { display: flex; justify-content: space-between; gap: 10px; align-items: center;
    padding: 12px 18px; border-top: 1px solid rgba(207,161,74,0.16); }
  .v3d-dim { color: #cfa14a; font-size: 13px; font-weight: 600; }
  .v3d-hint { color: #8f8471; font-size: 12px; text-align: right; }
</style>

<script>
  (function () {
    var root = document.getElementById('v3d-{{ section.id }}')
    if (!root) return
    var modal = root.querySelector('[data-v3d-modal]')

    // La visionneuse se charge quand la carte approche de l'écran.
    function loadViewer() {
      if (!window.customElements || customElements.get('model-viewer')) return
      if (document.querySelector('script[data-v3d-lib]')) return
      var s = document.createElement('script')
      s.type = 'module'
      s.setAttribute('data-v3d-lib', '')
      s.src = 'https://ajax.googleapis.com/ajax/libs/model-viewer/4.0.0/model-viewer.min.js'
      document.head.appendChild(s)
    }
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        if (entries.some(function (e) { return e.isIntersecting })) { loadViewer(); io.disconnect() }
      }, { rootMargin: '400px' })
      io.observe(root)
    } else {
      loadViewer()
    }

    function openModal() {
      loadViewer()
      modal.hidden = false
      document.documentElement.style.overflow = 'hidden'
    }
    function closeModal() {
      modal.hidden = true
      document.documentElement.style.overflow = ''
    }
    root.querySelectorAll('[data-v3d-open]').forEach(function (el) {
      el.addEventListener('click', openModal)
      el.addEventListener('keydown', function (e) {
        if (el.tagName !== 'BUTTON' && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); openModal() }
      })
    })
    modal.querySelectorAll('[data-v3d-close]').forEach(function (el) {
      el.addEventListener('click', closeModal)
    })
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !modal.hidden) closeModal()
    })
  })()
</script>
{%- endif -%}

{% schema %}
{
  "name": "Velluce 3D",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "badge", "label": "Badge", "default": "Expérience Velluce" },
    { "type": "text", "id": "titre", "label": "Titre", "default": "Visualisez-le chez vous, en 3D" },
    { "type": "textarea", "id": "texte", "label": "Texte", "default": "Votre luminaire tourne devant vous en trois dimensions. Touchez « Voir chez moi » : il apparaît dans votre pièce, suspendu à hauteur réelle, à ses dimensions exactes. Vous saurez en dix secondes s'il est fait pour votre intérieur." },
    { "type": "text", "id": "bouton", "label": "Bouton", "default": "Voir en 3D chez moi" },
    { "type": "text", "id": "note", "label": "Note sous le bouton", "default": "Taille réelle · Sans application · iPhone & Android" },
    { "type": "text", "id": "mention_dimensions", "label": "Mention dimensions", "default": "Taille réelle · suspendu à 2,40 m comme au plafond" }
  ],
  "presets": [{ "name": "Velluce 3D" }]
}
{% endschema %}
