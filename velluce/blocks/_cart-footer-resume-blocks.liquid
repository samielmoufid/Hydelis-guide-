{% comment %}
  Velluce — Récapitulatif du panier.

  Remplace le résumé d'origine (réduction + total estimé) par un bloc
  qui met l'économie en avant avant de demander la carte bancaire :
  combien on gagne, d'où ça vient, et ce qu'il reste à payer.

  L'économie affichée additionne deux choses :
  - l'écart avec le prix barré (compare_at_price) ;
  - les remises réellement appliquées (codes et remises automatiques).
{% endcomment %}

{%- liquid
  assign ref_total = 0
  for item in cart.items
    assign unit_ref = item.original_price
    if item.variant.compare_at_price > unit_ref
      assign unit_ref = item.variant.compare_at_price
    endif
    assign line_ref = unit_ref | times: item.quantity
    assign ref_total = ref_total | plus: line_ref
  endfor

  assign total_saving = ref_total | minus: cart.total_price
  assign promo_saving = cart.original_total_price | minus: cart.total_price

  assign free_from = block.settings.ship_free_from | times: 100
  assign ship_free = false
  if free_from > 0 and cart.total_price >= free_from
    assign ship_free = true
  endif

  assign saving_pct = 0
  if ref_total > 0 and total_saving > 0
    assign saving_pct = total_saving | times: 100 | divided_by: ref_total
  endif
-%}

<div
  class="cart-footer-resume-blocks vcart{% if block.settings.wrap_in_card %} card color-{{ block.settings.color_scheme }}{% endif %}"
  style="--margin-top: {{ block.settings.margin_top }}px; --margin-bottom: {{ block.settings.margin_bottom }}px;"
>
  {% content_for 'blocks' %}

  {%- if total_saving > 0 -%}
    <div class="vcart__save">
      <div class="vcart__save-head">
        <span class="vcart__save-label">
          <svg class="vcart__spark" viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M12 2.6l1.9 5.1 5.5.3-4.2 3.5 1.4 5.3L12 13.9l-4.6 2.9 1.4-5.3L4.6 8l5.5-.3z"
              fill="currentColor"
            />
          </svg>
          {{ block.settings.save_label }}
        </span>
        <span class="vcart__save-amount">&minus;{{ total_saving | money }}</span>
      </div>

      <ul class="vcart__save-list">
        {%- for discount in cart.cart_level_discount_applications -%}
          <li>
            <span>{{ discount.title }}</span>
            <span>&minus;{{ discount.total_allocated_amount | money }}</span>
          </li>
        {%- endfor -%}

        {%- for item in cart.items -%}
          {%- for allocation in item.line_level_discount_allocations -%}
            <li>
              <span>{{ allocation.discount_application.title }}</span>
              <span>&minus;{{ allocation.amount | money }}</span>
            </li>
          {%- endfor -%}
        {%- endfor -%}

        {%- assign compare_saving = total_saving | minus: promo_saving -%}
        {%- if compare_saving > 0 -%}
          <li>
            <span>{{ block.settings.compare_label }}</span>
            <span>&minus;{{ compare_saving | money }}</span>
          </li>
        {%- endif -%}
      </ul>

      {%- if saving_pct > 0 -%}
        <span class="vcart__save-badge">&minus;{{ saving_pct }}&nbsp;% sur ce panier</span>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="vcart__lines">
    <div class="vcart__line">
      <span>{{ block.settings.subtotal_label }}</span>
      <span class="vcart__line-value">
        {%- if ref_total > cart.total_price -%}
          <s>{{ ref_total | money }}</s>
        {%- endif -%}
        <strong>{{ cart.total_price | money }}</strong>
      </span>
    </div>

    {%- if block.settings.show_shipping -%}
      <div class="vcart__line">
        <span>{{ block.settings.shipping_label }}</span>
        <span class="vcart__line-value">
          {%- if ship_free -%}
            <strong class="vcart__free">{{ block.settings.shipping_free }}</strong>
          {%- else -%}
            <span class="vcart__soft">{{ block.settings.shipping_next }}</span>
          {%- endif -%}
        </span>
      </div>
    {%- endif -%}
  </div>

  <div class="vcart__total">
    <span class="vcart__total-label">{{ block.settings.total_label }}</span>
    <span class="vcart__total-value">{{ cart.total_price | money }}</span>
  </div>

  {%- if block.settings.tax_note != blank -%}
    <p class="vcart__tax">{{ block.settings.tax_note }}</p>
  {%- endif -%}

  {%- if block.settings.show_trust -%}
    <ul class="vcart__trust">
      <li>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M12 2.8l7 2.6v5.3c0 4.3-2.9 8.2-7 9.5-4.1-1.3-7-5.2-7-9.5V5.4z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linejoin="round"
          />
        </svg>
        {{ block.settings.trust_1 }}
      </li>
      <li>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M4 11a8 8 0 1 1 2.3 5.7M4 16.5V11h5.5"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
        {{ block.settings.trust_2 }}
      </li>
      <li>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M6.5 10.5V8a5.5 5.5 0 1 1 11 0v2.5M5 10.5h14v9H5z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linejoin="round"
          />
        </svg>
        {{ block.settings.trust_3 }}
      </li>
    </ul>
  {%- endif -%}
</div>

{% stylesheet %}
  .cart-footer-resume-blocks {
    margin-top: var(--margin-top);
    margin-bottom: var(--margin-bottom);
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm);
  }

  .vcart {
    --vc-gold: #b08d57;
    --vc-ink: rgb(var(--color-foreground));
    --vc-soft: rgba(var(--color-foreground), .62);
    --vc-rule: rgba(var(--color-foreground), .14);
  }

  /* Le bloc économies */
  .vcart__save {
    position: relative;
    overflow: hidden;
    padding: 13px 15px;
    border-radius: 14px;
    border: 1px solid color-mix(in srgb, var(--vc-gold) 40%, transparent);
    background:
      linear-gradient(135deg,
        color-mix(in srgb, var(--vc-gold) 13%, transparent) 0%,
        color-mix(in srgb, var(--vc-gold) 5%, transparent) 100%);
  }

  .vcart__save-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .vcart__save-label {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: .13em;
    text-transform: uppercase;
    color: var(--vc-gold);
  }

  .vcart__spark { width: 14px; height: 14px; flex: 0 0 14px; }

  .vcart__save-amount {
    font-family: var(--font-heading-family, Georgia, serif);
    font-size: 23px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -.01em;
    color: var(--vc-ink);
    white-space: nowrap;
  }

  .vcart__save-list {
    margin: 9px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .vcart__save-list li {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--vc-soft);
  }

  .vcart__save-list li span:first-child {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .vcart__save-badge {
    display: inline-block;
    margin-top: 10px;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--vc-gold);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .06em;
  }

  /* Les lignes de détail */
  .vcart__lines { display: flex; flex-direction: column; gap: 7px; }

  .vcart__line {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    font-size: 14px;
    color: var(--vc-soft);
  }

  .vcart__line-value { display: inline-flex; align-items: baseline; gap: 8px; }
  .vcart__line-value s { opacity: .55; }
  .vcart__line-value strong { font-weight: 600; color: var(--vc-ink); }
  .vcart__free { color: var(--vc-gold) !important; }
  .vcart__soft { font-size: 13px; }

  /* Le total */
  .vcart__total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--vc-rule);
  }

  .vcart__total-label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--vc-ink);
  }

  .vcart__total-value {
    font-family: var(--font-heading-family, Georgia, serif);
    font-size: 26px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -.015em;
    color: var(--vc-ink);
  }

  .vcart__tax {
    margin: -2px 0 0;
    font-size: 11.5px;
    color: var(--vc-soft);
  }

  /* La ligne de réassurance */
  .vcart__trust {
    margin: 2px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
  }

  .vcart__trust li {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 11.5px;
    line-height: 1.3;
    color: var(--vc-soft);
  }

  .vcart__trust svg { width: 13px; height: 13px; flex: 0 0 13px; }

  /* Sur mobile le pied de panier ne doit pas manger l'écran :
     on resserre tout sans rien retirer de l'information. */
  @media (width <= 640px) {
    .vcart__save { padding: 11px 13px; border-radius: 12px; }
    .vcart__save-amount { font-size: 20px; }
    .vcart__save-list { margin-top: 7px; gap: 2px; }
    .vcart__save-list li { font-size: 12px; }
    .vcart__save-badge { margin-top: 8px; padding: 3px 9px; font-size: 10.5px; }
    .vcart__lines { gap: 5px; }
    .vcart__line { font-size: 13.5px; }
    .vcart__total { padding-top: 10px; }
    .vcart__total-value { font-size: 23px; }
    .vcart__trust { gap: 4px 11px; }
    .vcart__trust li { font-size: 10.5px; gap: 4px; }
    .vcart__trust svg { width: 11px; height: 11px; flex: 0 0 11px; }
  }

  @media (width <= 360px) {
    .vcart__save-amount { font-size: 18px; }
    .vcart__total-value { font-size: 21px; }
    .vcart__trust { gap: 3px 8px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:cart_footer_resume_blocks",
  "tag": null,
  "blocks": [
    { "type": "_cart-note" },
    { "type": "_cart-progress-bar" },
    { "type": "accordions" },
    { "type": "text" },
    { "type": "separator" },
    { "type": "_discount-code" },
    { "type": "cross-sell" },
    { "type": "slider" },
    { "type": "delivery-estimation" },
    { "type": "information-slider" }
  ],
  "settings": [
    { "type": "header", "content": "Économies" },
    { "type": "text", "id": "save_label", "label": "Titre du bloc", "default": "Vous économisez" },
    {
      "type": "text",
      "id": "compare_label",
      "label": "Libellé de la remise catalogue",
      "default": "Remise Velluce",
      "info": "Affiché pour l'écart avec le prix barré."
    },
    { "type": "header", "content": "Détail" },
    { "type": "text", "id": "subtotal_label", "label": "Sous-total", "default": "Sous-total" },
    { "type": "checkbox", "id": "show_shipping", "label": "Afficher la ligne livraison", "default": true },
    { "type": "text", "id": "shipping_label", "label": "Livraison", "default": "Livraison" },
    { "type": "text", "id": "shipping_free", "label": "Livraison offerte", "default": "Offerte" },
    {
      "type": "text",
      "id": "shipping_next",
      "label": "Livraison à calculer",
      "default": "Calculée à l'étape suivante"
    },
    {
      "type": "range",
      "id": "ship_free_from",
      "label": "Livraison offerte à partir de",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 30,
      "unit": "€"
    },
    { "type": "text", "id": "total_label", "label": "Total", "default": "Total" },
    { "type": "text", "id": "tax_note", "label": "Mention sous le total", "default": "TVA incluse" },
    { "type": "header", "content": "Réassurance" },
    { "type": "checkbox", "id": "show_trust", "label": "Afficher la ligne de réassurance", "default": true },
    { "type": "text", "id": "trust_1", "label": "Argument 1", "default": "Garantie 24 mois" },
    { "type": "text", "id": "trust_2", "label": "Argument 2", "default": "Retours 30 jours" },
    { "type": "text", "id": "trust_3", "label": "Argument 3", "default": "Paiement sécurisé" },
    { "type": "header", "content": "t:style" },
    { "type": "checkbox", "id": "wrap_in_card", "label": "t:wrap_in_card", "default": false },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:color_scheme",
      "default": "scheme-2",
      "visible_if": "{{ block.settings.wrap_in_card }}"
    },
    { "type": "header", "content": "t:margins" },
    {
      "type": "range",
      "id": "margin_top",
      "label": "t:margin_top",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "t:margin_bottom",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    }
  ],
  "presets": [{ "name": "t:cart_footer_resume_blocks" }]
}
{% endschema %}
