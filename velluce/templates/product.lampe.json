le-banner-{{ section.id }} .velluce-sale-text{\n  line-height:1;\n}\n\n#velluce-sale-banner-{{ section.id }} .velluce-sale-kicker{\n  font-family:Arial,sans-serif;\n  font-size:8px;\n  font-weight:800;\n  letter-spacing:.12em;\n  color:#8a8a8a;\n  text-transform:uppercase;\n  line-height:1;\n  margin-bottom:2px;\n}\n\n#velluce-sale-banner-{{ section.id }} .velluce-sale-main{\n  font-family:Arial,sans-serif;\n  font-size:14px;\n  font-weight:500;\n  color:#111;\n  line-height:1.05;\n}\n\n#velluce-sale-banner-{{ section.id }} .velluce-sale-main strong{\n  color:#cfc0ae;\n  font-weight:800;\n}\n\n@media(max-width:749px){\n  #velluce-sale-banner-{{ section.id }}{\n    max-width:100%;\n    padding:6px 9px;\n    gap:7px;\n    border-radius:9px;\n  }\n\n  #velluce-sale-banner-{{ section.id }} .velluce-sale-icon{\n    width:28px;\n    height:28px;\n    min-width:28px;\n  }\n\n  #velluce-sale-banner-{{ section.id }} .velluce-sale-icon svg{\n    width:14px;\n    height:14px;\n  }\n\n  #velluce-sale-banner-{{ section.id }} .velluce-sale-kicker{\n    font-size:7px;\n  }\n\n  #velluce-sale-banner-{{ section.id }} .velluce-sale-main{\n    font-size:13px;\n  }\n}\n</style>", "margin_top": 0, "margin_bottom": 0, "additional_class": ""}, "blocks": {}}, "text_zLqMQw": {"type": "text", "settings": {"show_on_display": "desktop_and_mobile", "text": "<p>{{ product.title }}</p>", "text_style": "h3", "paragraph_font_size": "normal", "font_weight": 400, "alignment": "left", "alignment_mobile": "left", "show_read_more": false, "read_more_length": 50, "read_more_text": "Voir plus", "read_less_text": "Voir moins", "truncate": false, "truncate_length": 2, "margin_top": 0, "margin_bottom": 0, "additional_class": ""}, "blocks": {}}, "rating_stars_Krck47": {"type": "rating-stars", "settings": {"show_on_display": "desktop_and_mobile", "product": "{{ closest.product }}", "hide_rating_when_no_reviews": true, "rating": 4.5, "show_note": true, "show_review_count": true, "review_count": 123, "link": "#reviews", "margin_top": 10, "margin_bottom": 0, "additional_class": ""}, "blocks": {}}, "price_yEeMeb": {"type": "product-price", "settings": {"show_on_display": "desktop_and_mobile", "product": "{{ closest.product }}", "sales_badge": "percentage", "show_sales_badge_text": false, "show_unit_price": false, "text_style": "paragraph", "additional_class": ""}, "blocks": {}}, "cc_delivery": {"type": "custom-code", "settings": {"show_on_display": "desktop_and_mobile", "custom_liquid": "<style>\n  .velluce-delivery-line {\n    display: flex;\n    align-items: center;\n    gap: 6px;\n    margin: 10px 0;\n    color: #cfc0ae;\n    font-size: 13.5px;\n    font-weight: 700;\n    line-height: 1.15;\n    white-space: nowrap;\n    max-width: 100%;\n    overflow: hidden;\n  }\n\n  .velluce-delivery-dot {\n    width: 9px;\n    height: 9px;\n    border-radius: 50%;\n    background: #cfc0ae;\n    flex-shrink: 0;\n    position: relative;\n    animation: velluceBlink 1.3s infinite;\n  }\n\n  .velluce-delivery-dot::after {\n    content: \"\";\n    position: absolute;\n    inset: -5px;\n    border-radius: 50%;\n    background: rgba(207, 192, 174, 0.22);\n    animation: vellucePulse 1.3s infinite;\n  }\n\n  .velluce-delivery-text {\n    color: #cfc0ae;\n    overflow: hidden;\n    text-overflow: ellipsis;\n  }\n\n  .velluce-delivery-date {\n    font-weight: 800;\n  }\n\n  @keyframes velluceBlink {\n    0%, 100% {\n      opacity: 1;\n      transform: scale(1);\n    }\n    50% {\n      opacity: 0.45;\n      transform: scale(0.85);\n    }\n  }\n\n  @keyframes vellucePulse {\n    0% {\n      transform: scale(0.7);\n      opacity: 0.55;\n    }\n    70% {\n      transform: scale(1.45);\n      opacity: 0;\n    }\n    100% {\n      transform: scale(1.45);\n      opacity: 0;\n    }\n  }\n\n  @media screen and (max-width: 480px) {\n    .velluce-delivery-line {\n      font-size: 11.8px;\n      gap: 5px;\n      margin: 9px 0;\n    }\n\n    .velluce-delivery-dot {\n      width: 8px;\n      height: 8px;\n    }\n  }\n</style>\n\n<div class=\"velluce-delivery-line\" data-velluce-delivery>\n  <span class=\"velluce-delivery-dot\"></span>\n  <span class=\"velluce-delivery-text\">\n    Exp\u00e9di\u00e9 demain \u00b7 livr\u00e9\n    <span class=\"velluce-delivery-date\" data-date-start></span>&nbsp;-&nbsp;<span class=\"velluce-delivery-date\" data-date-end></span>\n  </span>\n</div>\n\n<script>\n  document.addEventListener(\"DOMContentLoaded\", function () {\n    document.querySelectorAll(\"[data-velluce-delivery]\").forEach(function (block) {\n      var startElement = block.querySelector(\"[data-date-start]\");\n      var endElement = block.querySelector(\"[data-date-end]\");\n\n      if (!startElement || !endElement) return;\n\n      var startDate = new Date();\n      var endDate = new Date();\n\n      startDate.setDate(startDate.getDate() + 3);\n      endDate.setDate(endDate.getDate() + 10);\n\n      var sameMonth = startDate.getMonth() === endDate.getMonth() &&\n                      startDate.getFullYear() === endDate.getFullYear();\n\n      var shortMonth = {\n        day: \"numeric\",\n        month: \"short\"\n      };\n\n      if (sameMonth) {\n        startElement.textContent = startDate.getDate();\n        endElement.textContent = endDate.toLocaleDateString(\"fr-FR\", shortMonth).replace(\".\", \"\");\n      } else {\n        startElement.textContent = startDate.toLocaleDateString(\"fr-FR\", shortMonth).replace(\".\", \"\");\n        endElement.textContent = endDate.toLocaleDateString(\"fr-FR\", shortMonth).replace(\".\", \"\");\n      }\n    });\n  });\n</script>", "margin_top": 0, "margin_bottom": 0, "additional_class": ""}, "blocks": {}}, "cc_compat": {"type": "custom-code", "settings": {"show_on_display": "desktop_and_mobile", "custom_liquid": "<style>\n.velluce-compat-line{\n  width:100%;\n  background:#fff;\n  border:1px solid #e5e7eb;\n  border-radius:14px;\n  padding:14px 20px;\n  display:flex;\n  align-items:center;\n  gap:12px;\n  color:#141827;\n  font-size:17px;\n  line-height:1.2;\n  font-weight:700;\n  letter-spacing:-.2px;\n  white-space:nowrap;\n}\n.velluce-compat-line:before{\n  content:\"\";\n  width:6px;\n  height:26px;\n  background:#cfc0ae;\n  border-radius:99px;\n  flex:0 0 6px;\n}\n@media(max-width:749px){\n  .velluce-compat-line{\n    font-size:13px;\n    padding:12px 14px;\n    border-radius:12px;\n    gap:9px;\n    white-space:normal;\n  }\n  .velluce-compat-line:before{\n    height:22px;\n    width:5px;\n    flex-basis:5px;\n  }\n}\n</style>\n\n<div class=\"velluce-compat-line\">\n  Certifi\u00e9 CE \u2014 \u00e9clairage d'appoint, ampoule LED E27 / E14 (non incluse)\n</div>", "margin_top": 0, "margin_bottom": 0, "additional_class": ""}, "blocks": {}}, "cc_benefits": {"type": "custom-code", "settings": {"show_on_display": "desktop_and_mobile", "custom_liquid": "<style>\n.benefits{\n  display:grid;\n  gap:9px;\n  margin:14px 0;\n}\n\n.benefit{\n  display:flex;\n  align-items:center;\n  gap:9px;\n  font-size:15px;\n  line-height:1.3;\n}\n\n.benefit strong{\n  font-weight:700;\n}\n\n.benefit:before{\n  content:\"\u2713\";\n  display:grid;\n  place-items:center;\n  width:20px;\n  height:20px;\n  border:1.5px solid #fff;\n  border-radius:50%;\n  background:#cfc0ae;\n  color:#fff;\n  font-size:12px;\n  font-weight:700;\n  flex:none;\n}\n\n@media(max-width:749px){\n  .benefit{\n    font-size:14px;\n  }\n}\n</style>\n\n<div class=\"benefits\">\n  <div class=\"benefit\"><span><strong>Design</strong> : m\u00e9tal laqu\u00e9, finition soign\u00e9e</span></div>\n  <div class=\"benefit\"><span><strong>Aucun outil</strong> : posez, branchez, allumez</span></div>\n  <div class=\"benefit\"><span><strong>\u00c9clairage</strong> d'appoint, ambiance chaleureuse</span></div>\n  <div class=\"benefit\"><span><strong>Compatibilit\u00e9</strong> : ampoules LED E27 / E14</span></div>\n</div>", "margin_top": 0, "margin_bottom": 0, "additional_class": ""}, "blocks": {}}, "text_yQdqF8": {"type": "text", "settings": {"show_