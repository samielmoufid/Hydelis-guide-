assage.</p>\n<p><strong>Combien de lumière ?</strong> Environ 100 à 150 lumens par m² dans un salon ou une chambre, 200 à 300 dans une cuisine ou une salle de bain.</p>\n<p>Un doute sur votre configuration ? Envoyez-nous les dimensions de votre pièce sur WhatsApp, on vous répond avec une taille précise.</p>","text_style":"paragraph","paragraph_font_size":"normal","font_weight":400,"alignment":"left","alignment_mobile":"left","show_read_more":false,"read_more_length":50,"read_more_text":"Voir plus","read_less_text":"Voir moins","truncate":false,"truncate_length":2,"margin_top":0,"margin_bottom":0,"additional_class":""},"blocks":{}}},"block_order":["text_LfyX9A","text_99rHbT"]}},"block_order":[]},"product-add-to-cart-button":{"type":"_product-add-to-cart-button","static":true,"settings":{"enable_sticky_add_to_cart":true,"button_style":"primary","show_price":true,"icon":"none","icon_custom":"","icon_position":"end","enable_preorder":false,"enable_preorder_on_empty_stock_only":true,"preorder_cart_message":"Livraison à partir du JJ/MM","additional_class":""},"blocks":{"product-quantity-selector":{"type":"_product-quantity-selector","disabled":true,"static":true,"settings":{"show_on_display":"desktop_and_mobile","additional_class":""},"blocks":{}},"add-to-wishlist-button":{"type":"_add-to-wishlist-button","static":true,"settings":{},"blocks":{}}},"block_order":[]},"accelerated-checkout":{"type":"_accelerated-checkout","static":true,"settings":{"show_on_display":"desktop_and_mobile","full_width":true,"button_style":"primary","margin_top":0,"margin_bottom":0,"additional_class":""},"blocks":{}}},"block_order":["product_variant_picker_xWC3wF"]},"payment_methods_BdjpFB":{"type":"custom-code","settings":{"show_on_display":"desktop_and_mobile","custom_liquid":"<style>\nproduct-form .shopify-payment-button, product-form shopify-accelerated-checkout, .accelerated-checkout, accelerated-checkout, [class*='accelerated-checkout']{display:none!important}\n.payment-icons-row {\n  displa