aragraph","font_weight":500,"margin_top":0,"margin_bottom":0,"additional_class":""},"blocks":{}}},"block_order":["icon_with_text_DWkBqr","icon_with_text_LqjaQL","icon_with_text_Y6hka8"]},"cc_accordions":{"type":"custom-code","settings":{"show_on_display":"desktop_and_mobile","custom_liquid":"<style>.bb-acc{border-top:1px solid #cfc0ae}.bb-acc:last-of-type{border-bottom:1px solid #cfc0ae}.bb-acc summary{display:flex;justify-content:space-between;align-items:center;padding:16px 2px;cursor:pointer;font-weight:700;font-size:15px;color:#1a1a1a;list-style:none}.bb-acc summary::-webkit-details-marker{display:none}.bb-acc summary:after{content:\"+\";font-size:20px;color:#cfc0ae;font-weight:400;transition:transform .2s}.bb-acc[open] summary:after{transform:rotate(45deg)}.bb-acc .bb-acc-body{padding:0 2px 16px;font-size:14px;line-height:1.6;color:#444}</style><details class=\"bb-acc\"><summary>Livraison &amp; retours</summary><div class=\"bb-acc-body\"><p>Votre commande est préparée sous 24 à 48 heures ouvrées, puis expédiée depuis notre entrepôt européen. Comptez ensuite 4 à 8 jours ouvrés pour la recevoir.</p><p>Vous recevez un e-mail de confirmation à la commande, puis un second avec votre numéro de suivi dès que le colis part. Aucun envoi ne se fait sans suivi.</p><p>Vous avez 30 jours à compter de la réception pour changer d'avis, sans avoir à vous justifier. Un retour, un échange : vous écrivez, on s'en occupe.</p></div></details><details class=\"bb-acc\"><summary>Qualité &amp; sécurité</summary><div class=\"bb-acc-body\"><p>Chaque référence est <strong>vérifiée, certifiée CE et conforme aux normes européennes</strong> avant d'entrer au catalogue. Sécurité électrique testée, finitions contrôlées, fixations éprouvées.</p><p>Nous gardons peu de modèles, volontairement. Un luminaire qui ne passe pas nos contrôles ne part pas en ligne — c'est plus simple à dire qu'à faire, mais c'est ce qui vous évite les mauvaises surprises.</p></div></details><details class=\"bb-acc\"><summary>Garantie 24 mois</summary><div class=\"bb-acc-body\"><p>Chaque produit Velluce est couvert par une <strong>garantie de 24 mois</strong>, incluse d'office et sans surcoût.</p><p>Un souci en 18 mois ? Vous nous écrivez, notre support répond 7j/7 en français, et on remplace ou on rembourse. Pas de formulaire à rallonge, pas d'expertise à faire à vos frais.</p></div></details>","margin_top":0,"margin_bottom":0,"additional_class":""},"blocks":{}},"cc_infocard":{"type":"custom-code","settings":{"show_on_display":"desktop_and_mobile","custom_liquid":"<style>\n  .velluce-info-card {\n    display: flex;\n    align-items: center;\n    gap: 14px;\n    width: 100%;\n    margin: 16px 0;\n    padding: 13px 14px;\n    border: 1px solid #e9e9e9;\n    border-radius: 14px;\n    background: #ffffff;\n    text-decoration: none;\n    color: inherit;\n    box-sizing: border-box;\n    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;\n  }\n\n  .velluce-info-card:hover {\n    border-color: #cfc0ae;\n    box-shadow: 0 8px 22px rgba(207, 192, 174, 0.12);\n    transform: translateY(-1px);\n  }\n\n  .velluce-info-card__image {\n    width: 82px;\n    height: 82px;\n    min-width: 82px;\n    border-radius: 12px;\n    overflow: hidden;\n    background: #f5f5f5;\n  }\n\n  .velluce-info-card__image img {\n    width: 100%;\n    height: 100%;\n    display: block;\n    object-fit: cover;\n    object-position: center;\n  }\n\n  .velluce-info-card__content {\n    flex: 1;\n    min-width: 0;\n  }\n\n  .velluce-info-card__title {\n    margin: 0 0 5px;\n    color: #111111;\n    font-size: 15.5px;\n    line-height: 1.2;\n    font-weight: 800;\n    letter-spacing: -0.01em;\n  }\n\n  .velluce-info-card__text {\n    margin: 0 0 8px;\n    color: #555555;\n    font-size: 13px;\n    line-height: 1.35;\n    font-weight: 400;\n  }\n\n  .velluce-info-card__link {\n    display: inline-flex;\n    align-items: center;\n    gap: 5px;\n    color: #111111;\n    font-size: 13px;\n    line