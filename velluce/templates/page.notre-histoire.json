{"sections": {"main": {"type": "main-page", "disabled": true, "settings": {"color_scheme": "", "wrap_in_card": false, "color_scheme_card": "", "hide_header_and_footer": false, "section_width": "normal", "layout_type": "flex", "layout_flex_direction_desktop": "column", "layout_grid_columns_desktop": 3, "layout_gap_desktop": 20, "layout_wrap_desktop": "nowrap", "layout_flex_justify_desktop": "flex-start", "layout_flex_align_items_desktop": "flex-start", "same_as_desktop": true, "layout_flex_direction_mobile": "column", "layout_gap_mobile": 20, "layout_wrap_mobile": "nowrap", "layout_flex_justify_mobile": "flex-start", "layout_flex_align_items_mobile": "flex-start", "layout_grid_columns_mobile": 1, "padding_top": 50, "padding_bottom": 50, "margin_top": 0, "margin_bottom": 0}}, "cc_intro": {"type": "custom-code", "settings": {"show_on_display": "desktop_and_mobile", "custom_liquid": "<div class=\"vllc-hi-head\">\n  <p class=\"vllc-hi-eyebrow\">Notre histoire</p>\n  <h1 class=\"vllc-hi-h1\">Nous ne vendons pas des ampoules.<br>Nous vendons le moment où<br>la pièce devient belle.</h1>\n  <p class=\"vllc-hi-lead\">Velluce est née d'un soir raté, dans un salon parisien mal éclairé. Voici comment une contrariété très banale est devenue une maison de luminaires.</p>\n</div>\n<style>\n.vllc-hi-head{max-width:920px;margin:0 auto;padding:76px 24px 10px;text-align:center}\n.vllc-hi-eyebrow{text-transform:uppercase;letter-spacing:2.4px;font-size:11.5px;font-weight:600;color:#a96e4f;margin:0 0 16px}\n.vllc-hi-h1{font-family:Georgia,'Times New Roman',serif;font-weight:400;font-size:46px;line-height:1.2;letter-spacing:-.4px;color:#1a1a1a;margin:0 0 20px}\n.vllc-hi-lead{font-size:17px;line-height:1.78;color:#5f5f5f;margin:0 auto;max-width:640px}\n@media(max-width:600px){.vllc-hi-h1{font-size:29px}.vllc-hi-head{padding-top:54px}.vllc-hi-lead{font-size:15.5px}}\n</style>", "margin_top": 0, "margin_bottom": 0, "additional_class": ""}}, "txtprem_1": {"type": "txtprem", "name": "Image texte prem", "settings": {"title": "Un premier appartement, et une lumière qui gâche tout", "text": "Paris, un dimanche de novembre. Un appartement enfin à nous, des meubles choisis un par un, des amis qui arrivent pour dîner.\n\nEt une lumière blanche, plate, verticale, tombée du plafonnier laissé par l'ancien locataire. Le bois de la table paraissait gris. Les murs beiges tiraient sur le jaune sale. Personne n'a rien dit — mais tout le monde a senti que la pièce n'y était pas.\n\nCe soir-là, nous avons compris quelque chose de bête et de définitif : on peut réussir toute une décoration et la faire échouer avec un seul luminaire.", "btn_label": "", "btn_link": "", "image": "shopify://shop_images/ChatGPT_Image_17_aout_2026_20_43_07.png", "img_position": "left", "text_width_desktop": 52, "image_width_desktop": 51, "text_height_desktop": 370, "img_height_desktop": 530, "desktop_gap": 32, "img_height_mobile": 250, "mobile_margin": 16, "padding_top": 44, "padding_bottom": 44, "padding_top_mobile": 32, "padding_bottom_mobile": 32, "text_padding": 32, "text_padding_mobile": 32, "title_font": "var(--font-heading-family, Georgia, serif)", "text_font": "var(--font-body-family, sans-serif)", "button_font": "var(--font-body-family, sans-serif)", "title_size_desktop": 36, "title_size_mobile": 26, "title_weight": "700", "title_margin_bottom": 20, "title_margin_bottom_mobile": 20, "text_size_desktop": 16, "text_size_mobile": 16, "text_weight": "400", "text_line_height": 1.8, "text_max_width": 720, "text_margin_bottom": 32, "text_margin_bottom_mobile": 28, "bg_color": "#ffffff", "text_bg_color": "#faf8f5", "title_color": "#1a1a1a", "text_color": "#4a4a4a", "btn_color": "#2c2c2c", "btn_text_color": "#ffffff", "img_radius": 18, "img_radius_mobile": 10, "text_radius": 18, "btn_size": 14, "btn_padding_y": 18, "btn_padding_x": 36, "btn_padding_y_mobile": 20, "btn_radius": 4}}, "txtprem_2": {"type": "txtprem", "name": "Image texte prem", "settings": {"title": "Trois semaines d'onglets ouverts pour ne rien savoir", "text": "Nous avons donc cherché. Des dizaines d'onglets, des marketplaces sans nom, des photos de studio impossibles à croire, des fiches produit qui donnent la puissance en watts mais jamais la température de couleur. Des avis qui se contredisent. Aucun indice IP quand il s'agit d'une salle de bains.\n\nNulle part une réponse aux seules questions qui comptaient vraiment : est-ce que ce sera chaleureux le soir ? Quel diamètre pour ma table ? À quelle hauteur je le pose ?\n\nNous avons acheté deux fois de travers avant de tomber juste. Personne ne devrait avoir à payer un apprentissage aussi cher pour éclairer son salon.", "btn_label": "", "btn_link": "", "image": "shopify://shop_images/ChatGPTImage19mai2026_17_20_05.png", "img_position": "right", "text_width_desktop": 52, "image_width_desktop": 51, "text_height_desktop": 370, "img_height_desktop": 530, "desktop_gap": 32, "img_height_mobile": 250, "mobile_margin": 16, "padding_top": 44, "padding_bottom": 44, "padding_top_mobile": 32, "padding_bottom_mobile": 32, "text_padding": 32, "text_padding_mobile": 32, "title_font": "var(--font-heading-family, Georgia, serif)", "text_font": "var(--font-body-family, sans-serif)", "button_font": "var(--font-body-family, sans-serif)", "title_size_desktop": 36, "title_size_mobile": 26, "title_weight": "700", "title_margin_bottom": 20, "title_margin_bottom_mobile": 20, "text_size_desktop": 16, "text_size_mobile": 16, "text_weight": "400", "text_line_height": 1.8, "text_max_width": 720, "text_margin_bottom": 32, "text_margin_bottom_mobile": 28, "bg_color": "#fdfbf8", "text_bg_color": "#faf8f5", "title_color": "#1a1a1a", "text_color": "#4a4a4a", "btn_color": "#2c2c2c", "btn_text_color": "#ffffff", "img_radius": 18, "img_radius_mobile": 10, "text_radius": 18, "btn_size": 14, "btn_padding_y": 18, "btn_padding_x": 36, "btn_padding_y_mobile": 20, "btn_radius": 4}}, "txtprem_3": {"type": "txtprem", "name": "Image texte prem", "settings": {"title": "Le déclic : l'ambiance, pas l'ampoule", "text": "En cherchant, nous avons appris ce que les vendeurs de luminaires ne racontent jamais. Que 2700K réchauffe un intérieur et que 4000K le refroidit. Qu'un indice de rendu des couleurs trop bas fait grisonner le bois et blafardir les visages. Qu'une pièce a besoin de trois sources de lumière, pas d'un plafonnier héroïque au centre.\n\nNous avons refait notre salon avec ces règles. La pièce n'avait pas changé — les murs, les meubles, la table étaient les mêmes. Elle était simplement devenue belle.\n\nVelluce est née exactement là : dans l'écart entre éclairer une pièce et lui donner une ambiance.", "btn_label": "", "btn_link": "", "image": "shopify://shop_images/ChatGPT_Image_17_aout_2026_20_30_35.png", "img_position": "left", "text_width_desktop": 52, "image_width_desktop": 51, "text_height_desktop": 370, "img_height_desktop": 530, "desktop_gap": 32, "img_height_mobile": 250, "mobile_margin": 16, "padding_top": 44, "padding_bottom": 44, "padding_top_mobile": 32, "padding_bottom_mobile": 32, "text_padding": 32, "text_padding_mobile": 32, "title_font": "var(--font-heading-family, Georgia, serif)", "text_font": "var(--font-body-family, sans-serif)", "button_font": "var(--font-body-family, sans-serif)", "title_size_desktop": 36, "title_size_mobile": 26, "title_weight": "700", "title_margin_bottom": 20, "title_margin_bottom_mobile": 20, "text_size_desktop": 16, "text_size_mobile": 16, "text_weight": "400", "text_line_height": 1.8, "text_max_width": 720, "text_margin_bottom": 32, "text_margin_bottom_mobile": 28, "bg_color": "#ffffff", "text_bg_color": "#faf8f5", "title_color": "#1a1a1a", "text_color": "#4a4a4a", "btn_color": "#2c2c2c", "btn_text_color": "#ffffff", "img_radius": 18, "img_radius_mobile": 10, "text_radius": 18, "btn_size": 14, "btn_padding_y": 18, "btn_padding_x": 36, "btn_padding_y_mobile": 20, "btn_radius": 4}}, "txtprem_4": {"type": "txtprem", "name": "Image texte prem", "settings": {"title": "Une règle, une seule, tenue depuis le premier jour", "text": "Ne jamais proposer ce que nous n'installerions pas chez nous.\n\nCette phrase paraît simple ; elle nous a fait refuser plus de produits que nous n'en avons acceptés. Le lustre magnifique en photo dont le métal pliait entre les doigts. La suspension parfaite vendue sans platine de fixation. L'applique « spéciale salle de bains » dont l'indice IP ne tenait pas trois jours au-dessus d'une douche.\n\nNous préférons une boutique courte et sûre à un catalogue infini où le client fait le tri à notre place. C'est moins rentable à court terme. C'est la seule façon de durer.", "btn_label": "", "btn_link": "", "image": "shopify://shop_images/ChatGPTImage18mai2026_20_00_00_1.png", "img_position": "right", "text_width_desktop": 52, "image_width_desktop": 51, "text_height_desktop": 370, "img_height_desktop": 530, "desktop_gap": 32, "img_height_mobile": 250, "mobile_margin": 16, "padding_top": 44, "padding_bottom": 44, "padding_top_mobile": 32, "padding_bottom_mobile": 32, "text_padding": 32, "text_padding_mobile": 32, "title_font": "var(--font-heading-family, Georgia, serif)", "text_font": "var(--font-body-family, sans-serif)", "button_font": "var(--font-body-family, sans-serif)", "title_size_desktop": 36, "title_size_mobile": 26, "title_weight": "700", "title_margin_bottom": 20, "title_margin_bottom_mobile": 20, "text_size_desktop": 16, "text_size_mobile": 16, "text_weight": "400", "text_line_height": 1.8, "text_max_width": 720, "text_margin_bottom": 32, "text_margin_bottom_mobile": 28, "bg_color": "#fdfbf8", "text_bg_color": "#faf8f5", "title_color": "#1a1a1a", "text_color": "#4a4a4a", "btn_color": "#2c2c2c", "btn_text_color": "#ffffff", "img_radius": 18, "img_radius_mobile": 10, "text_radius": 18, "btn_size": 14, "btn_padding_y": 18, "btn_padding_x": 36, "btn_padding_y_mobile": 20, "btn_radius": 4}}, "txtprem_5": {"type": "txtprem", "name": "Image texte prem", "settings": {"title": "Une palette, un fil, une signature", "text": "Nous avons aussi choisi une direction et nous nous y tenons : le beige, le bois clair, le noir mat, le laiton chaud, le verre, la pierre. Les matières des intérieurs français d'aujourd'hui.\n\nNi néons criards, ni chrome d'hôtel, ni plastique brillant. Des formes qui se remarquent sans crier, et qui vont encore aller avec votre canapé dans cinq ans.\n\nC'est pour ça que nos luminaires s'accordent entre eux : une suspension de la salle à manger, une applique du couloir et une lampe de chevet Velluce racontent la même histoire, même achetées à des mois d'intervalle.", "btn_label": "", "btn_link": "", "image": "shopify://shop_images/ChatGPT_Image_16_aout_2026_13_49_05.png", "img_position": "left", "text_width_desktop": 52, "image_width_desktop": 51, "text_height_desktop": 370, "img_height_desktop": 530, "desktop_gap": 32, "img_height_mobile": 250, "mobile_margin": 16, "padding_top": 44, "padding_bottom": 44, "padding_top_mobile": 32, "padding_bottom_mobile": 32, "text_padding": 32, "text_padding_mobile": 32, "title_font": "var(--font-heading-family, Georgia, serif)", "text_font": "var(--font-body-family, sans-serif)", "button_font": "var(--font-body-family, sans-serif)", "title_size_desktop": 36, "title_size_mobile": 26, "title_weight": "700", "title_margin_bottom": 20, "title_margin_bottom_mobile": 20, "text_size_desktop": 16, "text_size_mobile": 16, "text_weight": "400", "text_line_height": 1.8, "text_max_width": 720, "text_margin_bottom": 32, "text_margin_bottom_mobile": 28, "bg_color": "#ffffff", "text_bg_color": "#faf8f5", "title_color": "#1a1a1a", "text_color": "#4a4a4a", "btn_color": "#2c2c2c", "btn_text_color": "#ffffff", "img_radius": 18, "img_radius_mobile": 10, "text_radius": 18, "btn_size": 14, "btn_padding_y": 18, "btn_padding_x": 36, "btn_padding_y_mobile": 20, "btn_radius": 4}}, "txtprem_6": {"type": "txtprem", "name": "Image texte prem", "settings": {"title": "Aujourd'hui — et ce que nous vous devons", "text": "Velluce accompagne des intérieurs partout en France : des salons, des chambres d'enfant, des cuisines refaites le week-end, des salles de bains enfin terminées.\n\nNotre promesse tient en une phrase : vous donner la lumière dont votre intérieur a vraiment besoin, sans le doute qui va avec. Des luminaires vérifiés, certifiés, garantis 24 mois. Des conseils précis, en français, avant comme après l'achat. Et le droit de nous envoyer une photo de votre pièce pour qu'on vous dise franchement quoi faire.\n\nLe reste — les hauteurs, les Kelvin, les diamètres — c'est notre travail. Le vôtre commence quand vous allumez, un soir, et que la pièce est enfin comme vous l'imaginiez.", "btn_label": "DÉCOUVRIR NOS COLLECTIONS", "btn_link": "/collections/all", "image": "shopify://shop_images/ChatGPT_Image_16_aout_2026_13_42_50.png", "img_position": "right", "text_width_desktop": 52, "image_width_desktop": 51, "text_height_desktop": 370, "img_height_desktop": 530, "desktop_gap": 32, "img_height_mobile": 250, "mobile_margin": 16, "padding_top": 44, "padding_bottom": 44, "padding_top_mobile": 32, "padding_bottom_mobile": 32, "text_padding": 32, "text_padding_mobile": 32, "title_font": "var(--font-heading-family, Georgia, serif)", "text_font": "var(--font-body-family, sans-serif)", "button_font": "var(--font-body-family, sans-serif)", "title_size_desktop": 36, "title_size_mobile": 26, "title_weight": "700", "title_margin_bottom": 20, "title_margin_bottom_mobile": 20, "text_size_desktop": 16, "text_size_mobile": 16, "text_weight": "400", "text_line_height": 1.8, "text_max_width": 720, "text_margin_bottom": 32, "text_margin_bottom_mobile": 28, "bg_color": "#fdfbf8", "text_bg_color": "#faf8f5", "title_color": "#1a1a1a", "text_color": "#4a4a4a", "btn_color": "#2c2c2c", "btn_text_color": "#ffffff", "img_radius": 18, "img_radius_mobile": 10, "text_radius": 18, "btn_size": 14, "btn_padding_y": 18, "btn_padding_x": 36, "btn_padding_y_mobile": 20, "btn_radius": 4}}, "hero": {"type": "hero-vorha", "name": "Hero Vorha", "settings": {"eyebrow": "Velluce · Paris", "heading": "LA LUMIÈRE NE SE VOIT PAS.", "subheading": "ELLE SE RESSENT, TOUS LES SOIRS.", "heading_font": "sans_serif_n4", "text_font": "sans_serif_n4", "bg_color": "#faf8f5", "text_color": "#2c2c2c", "section_height": 510, "mobile_height": 340, "max_width": 500, "desktop_offset": -20, "mobile_offset": -10, "eyebrow_size": 13, "eyebrow_size_mobile": 11, "eyebrow_spacing": 0.5, "eyebrow_spacing_mobile": 0.4, "eyebrow_margin": 22, "eyebrow_margin_mobile": 12, "heading_size": 72, "heading_size_mobile": 31, "heading_weight": "400", "heading_weight_mobile": "500", "heading_spacing": 0, "heading_spacing_mobile": 0, "heading_line_height": 1, "heading_line_height_mobile": 1.1, "heading_margin": 30, "heading_margin_mobile": 24, "subheading_size": 15, "subheading_size_mobile": 14, "subheading_spacing": 0.4, "subheading_spacing_mobile": 0.4, "subheading_line_height": 1.4, "subheading_line_height_mobile": 1.5, "subheading_mobile_width": 340, "mobile_side_padding": 24}}, "bas_footer": {"type": "bas-footer", "name": "Séparateur géométrique", "settings": {"blue_color": "#cfc0ae", "height_desktop": 100, "height_mobile": 150}}, "velluce_hero_3d": {"type": "velluce-hero-3d", "settings": {"eyebrow": "Notre histoire", "heading": "De la première ampoule à votre salon.", "subheading": "Velluce est née d'un constat simple : trouver un beau luminaire, bien fabriqué et vendu honnêtement, ne devrait pas être un parcours du combattant. Voici d'où nous venons, et ce qui guide chacun de nos choix.", "badge_text": "Maison française · Paris", "model_url": "https://cdn.shopify.com/s/files/1/1015/2122/8163/files/deco-edison-histoire.glb?v=1787245862", "camera_orbit": "20deg 80deg 0.5m", "camera_target": "0m 0.01m 0m", "fov": "30deg"}}}, "order": ["velluce_hero_3d", "main", "cc_intro", "txtprem_1", "txtprem_2", "txtprem_3", "txtprem_4", "txtprem_5", "txtprem_6", "hero", "bas_footer"]}