{"sections": {"main": {"type": "main-page", "disabled": true, "settings": {"color_scheme": "", "wrap_in_card": false, "color_scheme_card": "", "hide_header_and_footer": false, "section_width": "normal", "layout_type": "flex", "layout_flex_direction_desktop": "column", "layout_grid_columns_desktop": 3, "layout_gap_desktop": 20, "layout_wrap_desktop": "nowrap", "layout_flex_justify_desktop": "flex-start", "layout_flex_align_items_desktop": "flex-start", "same_as_desktop": true, "layout_flex_direction_mobile": "column", "layout_gap_mobile": 20, "layout_wrap_mobile": "nowrap", "layout_flex_justify_mobile": "flex-start", "layout_flex_align_items_mobile": "flex-start", "layout_grid_columns_mobile": 1, "padding_top": 50, "padding_bottom": 50, "margin_top": 0, "margin_bottom": 0}}, "cc_intro": {"type": "custom-code", "settings": {"show_on_display": "desktop_and_mobile", "custom_liquid": "<div class=\"vllc-pr-head\">\n  <p class=\"vllc-pr-eyebrow\">Notre promesse</p>\n  <h1 class=\"vllc-pr-h1\">Un luminaire, on le pose une fois.<br>On n'a pas le droit de se tromper.</h1>\n  <p class=\"vllc-pr-lead\">Il restera au-dessus de votre table pendant les devoirs, les dimanches midi, les soirs où l'on ne fait rien. Vous le verrez tous les jours pendant des années. C'est pour cette raison que nous prenons autant de précautions avant qu'il n'entre dans notre catalogue — et que nous restons joignables longtemps après qu'il soit chez vous.</p>\n  <p class=\"vllc-pr-lead vllc-pr-lead--last\">Voici, précisément, ce à quoi nous nous engageons.</p>\n</div>\n<style>\n.vllc-pr-head{max-width:900px;margin:0 auto;padding:74px 24px 4px;text-align:center}\n.vllc-pr-eyebrow{text-transform:uppercase;letter-spacing:2.4px;font-size:11.5px;font-weight:600;color:#a96e4f;margin:0 0 16px}\n.vllc-pr-h1{font-family:Georgia,'Times New Roman',serif;font-weight:400;font-size:47px;line-height:1.16;letter-spacing:-.4px;color:#1a1a1a;margin:0 0 22px}\n.vllc-pr-lead{font-size:17px;line-height:1.78;color:#5f5f5f;margin:0 auto 14px;max-width:680px}\n.vllc-pr-lead--last{color:#2c2c2c;font-style:italic;margin-bottom:0}\n@media(max-width:600px){.vllc-pr-h1{font-size:30px}.vllc-pr-head{padding-top:52px}.vllc-pr-lead{font-size:15.5px}}\n</style>", "margin_top": 0, "margin_bottom": 0, "additional_class": ""}}, "title_premium": {"type": "title-premium", "name": "Titre collection premium", "settings": {"custom_title": "Sept engagements. Aucun astérisque.", "title_position": "center", "title_font_style": "premium", "font_weight": "600", "font_size_desktop": 52, "font_size_mobile": 30, "padding_top": 44, "padding_bottom": 8, "padding_top_mobile": 36, "padding_bottom_mobile": 18, "padding_left_desktop": 64, "padding_right_desktop": 64, "padding_left_mobile": 20, "padding_right_mobile": 20, "text_color": "#111111", "bg_color": "#ffffff"}}, "cc_grid": {"type": "custom-code", "settings": {"show_on_display": "desktop_and_mobile", "custom_liquid": "<div class=\"vllc-pr-grid-wrap\">\n  <div class=\"vllc-pr-grid\">\n    <div class=\"vllc-pr-card\"><span>01</span><strong>Une sélection resserrée</strong><em>Quelques dizaines de modèles choisis, pas dix mille références vues nulle part.</em></div>\n    <div class=\"vllc-pr-card\"><span>02</span><strong>La lumière juste</strong><em>2700K, IRC élevé, intensité variable : l'ambiance avant la puissance.</em></div>\n    <div class=\"vllc-pr-card\"><span>03</span><strong>Posé en 30 minutes</strong><em>Platine, vis et chevilles incluses. Cotes de pose indiquées noir sur blanc.</em></div>\n    <div class=\"vllc-pr-card\"><span>04</span><strong>Contrôlé avant d'entrer</strong><em>Marquage CE, indice IP adapté à la pièce, sécurité électrique vérifiée.</em></div>\n    <div class=\"vllc-pr-card\"><span>05</span><strong>Garanti 24 mois</strong><em>Incluse d'office, sans surcoût, sans conditions cachées.</em></div>\n    <div class=\"vllc-pr-card\"><span>06</span><strong>Une vraie personne</strong><em>Avant l'achat pour choisir, après la livraison pour poser. 7j/7.</em></div>\n    <div class=\"vllc-pr-card\"><span>07</span><strong>Le prix affiché</strong><em>Livraison offerte, aucun frais qui apparaît à la dernière étape.</em></div>\n  </div>\n</div>\n<style>\n.vllc-pr-grid-wrap{background:#faf8f5;padding:52px 20px}\n.vllc-pr-grid{max-width:1180px;margin:0 auto;display:grid;grid-template-columns:repeat(4,1fr);gap:14px}\n.vllc-pr-card{background:#fff;border:1px solid #ece2d3;border-radius:16px;padding:22px 20px;transition:transform .22s ease,box-shadow .22s ease}\n.vllc-pr-card:hover{transform:translateY(-3px);box-shadow:0 14px 32px rgba(169,110,79,.12)}\n.vllc-pr-card span{display:block;font-family:Georgia,serif;font-size:13px;color:#cfc0ae;letter-spacing:1px;margin-bottom:12px}\n.vllc-pr-card strong{display:block;font-size:16px;color:#1a1a1a;margin-bottom:7px;letter-spacing:-.2px}\n.vllc-pr-card em{display:block;font-style:normal;font-size:13.5px;line-height:1.6;color:#6f6f6f}\n@media(max-width:1000px){.vllc-pr-grid{grid-template-columns:repeat(2,1fr)}}\n@media(max-width:560px){.vllc-pr-grid{grid-template-columns:1fr;gap:10px}.vllc-pr-grid-wrap{padding:36px 16px}}\n</style>", "margin_top": 0, "margin_bottom": 0, "additional_class": ""}}, "txtprem_1": {"type": "txtprem", "name": "Image texte prem", "settings": {"title": "Nous préférons refuser un produit que remplir une page", "text": "Il serait facile de mettre mille luminaires en ligne et de laisser le hasard faire le reste. Nous faisons l'inverse.\n\nChaque modèle passe le même filtre, dans cet ordre : est-il beau une fois posé, pas seulement sur la photo du fournisseur ? Tient-il la main quand on le manipule ? Son verre, son métal, son bois vieilliront-ils bien ? Est-il sûr, aux normes, adapté à la pièce pour laquelle on le vend ?\n\nUn seul non, et il n'entre pas. C'est ce qui explique un catalogue volontairement court — et c'est aussi ce qui fait que vous pouvez commander en confiance : nous avons déjà éliminé pour vous ce qui ne valait pas le coup.", "btn_label": "", "btn_link": "", "image": "shopify://shop_images/ChatGPT_Image_17_aout_2026_20_21_29.png", "img_position": "left", "text_width_desktop": 52, "image_width_desktop": 51, "text_height_desktop": 370, "img_height_desktop": 530, "desktop_gap": 32, "img_height_mobile": 250, "mobile_margin": 16, "padding_top": 44, "padding_bottom": 44, "padding_top_mobile": 32, "padding_bottom_mobile": 32, "text_padding": 32, "text_padding_mobile": 32, "title_font": "var(--font-heading-family, Georgia, serif)", "text_font": "var(--font-body-family, sans-serif)", "button_font": "var(--font-body-family, sans-serif)", "title_size_desktop": 36, "title_size_mobile": 26, "title_weight": "700", "title_margin_bottom": 20, "title_margin_bottom_mobile": 20, "text_size_desktop": 16, "text_size_mobile": 16, "text_weight": "400", "text_line_height": 1.8, "text_max_width": 720, "text_margin_bottom": 32, "text_margin_bottom_mobile": 28, "bg_color": "#ffffff", "text_bg_color": "#faf8f5", "title_color": "#1a1a1a", "text_color": "#4a4a4a", "btn_color": "#2c2c2c", "btn_text_color": "#ffffff", "img_radius": 18, "img_radius_mobile": 10, "text_radius": 18, "btn_size": 14, "btn_padding_y": 18, "btn_padding_x": 36, "btn_padding_y_mobile": 20, "btn_radius": 4}}, "txtprem_2": {"type": "txtprem", "name": "Image texte prem", "settings": {"title": "La lumière juste, pas la lumière forte", "text": "C'est la différence que personne n'explique, et c'est tout notre métier.\n\nUne pièce peut être parfaitement éclairée et parfaitement désagréable. Ce qui rend un salon chaleureux le soir, ce n'est pas le nombre de watts : c'est une température de couleur chaude, autour de 2700K, un indice de rendu des couleurs élevé pour que le bois reste du bois et le beige reste du beige, et la possibilité de baisser l'intensité quand la journée est finie.\n\nNous choisissons nos luminaires avec ce regard-là. Vous n'achetez pas un objet qui éclaire : vous achetez la lumière dans laquelle vous allez vivre.", "btn_label": "", "btn_link": "", "image": "shopify://shop_images/ChatGPT_Image_17_aout_2026_20_30_35.png", "img_position": "right", "text_width_desktop": 52, "image_width_desktop": 51, "text_height_desktop": 370, "img_height_desktop": 530, "desktop_gap": 32, "img_height_mobile": 250, "mobile_margin": 16, "padding_top": 44, "padding_bottom": 44, "padding_top_mobile": 32, "padding_bottom_mobile": 32, "text_padding": 32, "text_padding_mobile": 32, "title_font": "var(--font-heading-family, Georgia, serif)", "text_font": "var(--font-body-family, sans-serif)", "button_font": "var(--font-body-family, sans-serif)", "title_size_desktop": 36, "title_size_mobile": 26, "title_weight": "700", "title_margin_bottom": 20, "title_margin_bottom_mobile": 20, "text_size_desktop": 16, "text_size_mobile": 16, "text_weight": "400", "text_line_height": 1.8, "text_max_width": 720, "text_margin_bottom": 32, "text_margin_bottom_mobile": 28, "bg_color": "#fdfbf8", "text_bg_color": "#faf8f5", "title_color": "#1a1a1a", "text_color": "#4a4a4a", "btn_color": "#2c2c2c", "btn_text_color": "#ffffff", "img_radius": 18, "img_radius_mobile": 10, "text_radius": 18, "btn_size": 14, "btn_padding_y": 18, "btn_padding_x": 36, "btn_padding_y_mobile": 20, "btn_radius": 4}}, "txtprem_3": {"type": "txtprem", "name": "Image texte prem", "settings": {"title": "Tout est dans le carton. Y compris ce qu'on oublie toujours", "text": "Le pire moment d'un achat de luminaire, c'est celui où l'on ouvre la boîte, escabeau déjà déplié, et où il manque la platine, les chevilles, ou la cote qui dit à quelle hauteur percer.\n\nChez nous : platine de fixation, vis, chevilles et notice illustrée dans chaque colis. Les cotes de pose sont indiquées noir sur blanc, et les hauteurs recommandées figurent sur la fiche produit — 75 à 90 cm au-dessus d'une table, 1,95 m minimum dans un couloir.\n\nComptez trente minutes pour un plafonnier, un peu plus pour une suspension à régler. Et si vous bloquez, on répond sur WhatsApp pendant que vous êtes encore sur l'escabeau.", "btn_label": "", "btn_link": "", "image": "shopify://shop_images/ChatGPT_Image_17_aout_2026_20_16_07.png", "img_position": "left", "text_width_desktop": 52, "image_width_desktop": 51, "text_height_desktop": 370, "img_height_desktop": 530, "desktop_gap": 32, "img_height_mobile": 250, "mobile_margin": 16, "padding_top": 44, "padding_bottom": 44, "padding_top_mobile": 32, "padding_bottom_mobile": 32, "text_padding": 32, "text_padding_mobile": 32, "title_font": "var(--font-heading-family, Georgia, serif)", "text_font": "var(--font-body-family, sans-serif)", "button_font": "var(--font-body-family, sans-serif)", "title_size_desktop": 36, "title_size_mobile": 26, "title_weight": "700", "title_margin_bottom": 20, "title_margin_bottom_mobile": 20, "text_size_desktop": 16, "text_size_mobile": 16, "text_weight": "400", "text_line_height": 1.8, "text_max_width": 720, "text_margin_bottom": 32, "text_margin_bottom_mobile": 28, "bg_color": "#ffffff", "text_bg_color": "#faf8f5", "title_color": "#1a1a1a", "text_color": "#4a4a4a", "btn_color": "#2c2c2c", "btn_text_color": "#ffffff", "img_radius": 18, "img_radius_mobile": 10, "text_radius": 18, "btn_size": 14, "btn_padding_y": 18, "btn_padding_x": 36, "btn_padding_y_mobile": 20, "btn_radius": 4}}, "txtprem_4": {"type": "txtprem", "name": "Image texte prem", "settings": {"title": "Vérifié avant d'entrer au catalogue, pas après la réclamation", "text": "Ce qui éclaire votre maison n'a pas droit à l'approximation.\n\nChaque référence Velluce est marquée CE et conforme aux normes européennes en vigueur pour les luminaires. Nous contrôlons la sécurité électrique, la qualité des borniers, l'isolation, la solidité des fixations. Nous vérifions surtout que l'indice IP correspond réellement à l'usage annoncé : IP65 au-dessus d'une douche, IP44 autour d'un miroir, IP65 pour une façade exposée.\n\nC'est le genre de détail invisible sur une photo, et le premier responsable des mauvaises surprises ailleurs.", "btn_label": "", "btn_link": "", "image": "shopify://shop_images/ChatGPTImage19mai2026_17_12_06.png", "img_position": "right", "text_width_desktop": 52, "image_width_desktop": 51, "text_height_desktop": 370, "img_height_desktop": 530, "desktop_gap": 32, "img_height_mobile": 250, "mobile_margin": 16, "padding_top": 44, "padding_bottom": 44, "padding_top_mobile": 32, "padding_bottom_mobile": 32, "text_padding": 32, "text_padding_mobile": 32, "title_font": "var(--font-heading-family, Georgia, serif)", "text_font": "var(--font-body-family, sans-serif)", "button_font": "var(--font-body-family, sans-serif)", "title_size_desktop": 36, "title_size_mobile": 26, "title_weight": "700", "title_margin_bottom": 20, "title_margin_bottom_mobile": 20, "text_size_desktop": 16, "text_size_mobile": 16, "text_weight": "400", "text_line_height": 1.8, "text_max_width": 720, "text_margin_bottom": 32, "text_margin_bottom_mobile": 28, "bg_color": "#fdfbf8", "text_bg_color": "#faf8f5", "title_color": "#1a1a1a", "text_color": "#4a4a4a", "btn_color": "#2c2c2c", "btn_text_color": "#ffffff", "img_radius": 18, "img_radius_mobile": 10, "text_radius": 18, "btn_size": 14, "btn_padding_y": 18, "btn_padding_x": 36, "btn_padding_y_mobile": 20, "btn_radius": 4}}, "txtprem_5": {"type": "txtprem", "name": "Image texte prem", "settings": {"title": "Garanti 24 mois, sans astérisque", "text": "Votre intérieur va changer. Le luminaire, lui, doit tenir.\n\nChaque produit Velluce est couvert 24 mois, incluse d'office, sans surcoût et sans conditions cachées. Pendant ces deux ans, un défaut est présumé exister depuis l'achat : ce n'est pas à vous de le prouver. Nous réparons ou remplaçons sans frais, frais de port compris. Une réparation prolonge la garantie de six mois, un remplacement en ouvre une nouvelle de deux ans.\n\nEt si un verre casse ou qu'une télécommande disparaît trois ans plus tard, nous vous envoyons la pièce détachée. Un luminaire ne devrait pas finir à la benne pour si peu.", "btn_label": "", "btn_link": "", "image": "shopify://shop_images/ChatGPTImage19mai2026_20_21_29.png", "img_position": "left", "text_width_desktop": 52, "image_width_desktop": 51, "text_height_desktop": 370, "img_height_desktop": 530, "desktop_gap": 32, "img_height_mobile": 250, "mobile_margin": 16, "padding_top": 44, "padding_bottom": 44, "padding_top_mobile": 32, "padding_bottom_mobile": 32, "text_padding": 32, "text_padding_mobile": 32, "title_font": "var(--font-heading-family, Georgia, serif)", "text_font": "var(--font-body-family, sans-serif)", "button_font": "var(--font-body-family, sans-serif)", "title_size_desktop": 36, "title_size_mobile": 26, "title_weight": "700", "title_margin_bottom": 20, "title_margin_bottom_mobile": 20, "text_size_desktop": 16, "text_size_mobile": 16, "text_weight": "400", "text_line_height": 1.8, "text_max_width": 720, "text_margin_bottom": 32, "text_margin_bottom_mobile": 28, "bg_color": "#ffffff", "text_bg_color": "#faf8f5", "title_color": "#1a1a1a", "text_color": "#4a4a4a", "btn_color": "#2c2c2c", "btn_text_color": "#ffffff", "img_radius": 18, "img_radius_mobile": 10, "text_radius": 18, "btn_size": 14, "btn_padding_y": 18, "btn_padding_x": 36, "btn_padding_y_mobile": 20, "btn_radius": 4}}, "txtprem_6": {"type": "txtprem", "name": "Image texte prem", "settings": {"title": "Une vraie personne, avant et après", "text": "Nous ne disparaissons pas une fois la commande passée. C'est même là que le travail commence.\n\nAvant l'achat, envoyez-nous une photo de votre pièce : on vous dit si le modèle fonctionne, quel diamètre prendre, à quelle hauteur le poser. Si notre luminaire n'est pas le bon, on vous le dit aussi — quitte à ne pas faire la vente.\n\nAprès la livraison, on vous accompagne sur la pose, le choix de l'ampoule, le réglage de l'intensité. Une réponse humaine, en français, 7j/7. Pas un script, pas un robot, pas un numéro de ticket.", "btn_label": "", "btn_link": "", "image": "shopify://shop_images/ChatGPT_Image_16_aout_2026_13_51_11.png", "img_position": "right", "text_width_desktop": 52, "image_width_desktop": 51, "text_height_desktop": 370, "img_height_desktop": 530, "desktop_gap": 32, "img_height_mobile": 250, "mobile_margin": 16, "padding_top": 44, "padding_bottom": 44, "padding_top_mobile": 32, "padding_bottom_mobile": 32, "text_padding": 32, "text_padding_mobile": 32, "title_font": "var(--font-heading-family, Georgia, serif)", "text_font": "var(--font-body-family, sans-serif)", "button_font": "var(--font-body-family, sans-serif)", "title_size_desktop": 36, "title_size_mobile": 26, "title_weight": "700", "title_margin_bottom": 20, "title_margin_bottom_mobile": 20, "text_size_desktop": 16, "text_size_mobile": 16, "text_weight": "400", "text_line_height": 1.8, "text_max_width": 720, "text_margin_bottom": 32, "text_margin_bottom_mobile": 28, "bg_color": "#fdfbf8", "text_bg_color": "#faf8f5", "title_color": "#1a1a1a", "text_color": "#4a4a4a", "btn_color": "#2c2c2c", "btn_text_color": "#ffffff", "img_radius": 18, "img_radius_mobile": 10, "text_radius": 18, "btn_size": 14, "btn_padding_y": 18, "btn_padding_x": 36, "btn_padding_y_mobile": 20, "btn_radius": 4}}, "txtprem_7": {"type": "txtprem", "name": "Image texte prem", "settings": {"title": "Le prix affiché est le prix payé", "text": "Livraison offerte sur tout le catalogue, sans minimum. Aucun frais qui apparaît à la dernière étape du panier, aucune option de « protection » à décocher, aucun prix barré inventé pour faire joli.\n\nQuand nous affichons une remise, elle porte sur un prix que nous avons réellement pratiqué. C'est une exigence légale en France, et nous préférons la respecter plutôt que de jouer au marchand de tapis.\n\nVous devez pouvoir comparer, réfléchir, revenir demain — et retrouver le même prix.", "btn_label": "DÉCOUVRIR NOS COLLECTIONS", "btn_link": "/collections/all", "image": "shopify://shop_images/ChatGPT_Image_16_aout_2026_13_49_05.png", "img_position": "left", "text_width_desktop": 52, "image_width_desktop": 51, "text_height_desktop": 370, "img_height_desktop": 530, "desktop_gap": 32, "img_height_mobile": 250, "mobile_margin": 16, "padding_top": 44, "padding_bottom": 44, "padding_top_mobile": 32, "padding_bottom_mobile": 32, "text_padding": 32, "text_padding_mobile": 32, "title_font": "var(--font-heading-family, Georgia, serif)", "text_font": "var(--font-body-family, sans-serif)", "button_font": "var(--font-body-family, sans-serif)", "title_size_desktop": 36, "title_size_mobile": 26, "title_weight": "700", "title_margin_bottom": 20, "title_margin_bottom_mobile": 20, "text_size_desktop": 16, "text_size_mobile": 16, "text_weight": "400", "text_line_height": 1.8, "text_max_width": 720, "text_margin_bottom": 32, "text_margin_bottom_mobile": 28, "bg_color": "#ffffff", "text_bg_color": "#faf8f5", "title_color": "#1a1a1a", "text_color": "#4a4a4a", "btn_color": "#2c2c2c", "btn_text_color": "#ffffff", "img_radius": 18, "img_radius_mobile": 10, "text_radius": 18, "btn_size": 14, "btn_padding_y": 18, "btn_padding_x": 36, "btn_padding_y_mobile": 20, "btn_radius": 4}}, "hero": {"type": "hero-vorha", "name": "Hero Vorha", "settings": {"eyebrow": "Velluce", "heading": "CE QUE NOUS VOUS DEVONS,", "subheading": "NOUS L'ÉCRIVONS AVANT LA VENTE.", "heading_font": "sans_serif_n4", "text_font": "sans_serif_n4", "bg_color": "#faf8f5", "text_color": "#2c2c2c", "section_height": 300, "mobile_height": 370, "max_width": 650, "desktop_offset": 10, "mobile_offset": -10, "eyebrow_size": 11, "eyebrow_size_mobile": 13, "eyebrow_spacing": 0.5, "eyebrow_spacing_mobile": 0.4, "eyebrow_margin": 22, "eyebrow_margin_mobile": 8, "heading_size": 72, "heading_size_mobile": 34, "heading_weight": "400", "heading_weight_mobile": "500", "heading_spacing": 0, "heading_spacing_mobile": 0, "heading_line_height": 1, "heading_line_height_mobile": 1.1, "heading_margin": 30, "heading_margin_mobile": 24, "subheading_size": 15, "subheading_size_mobile": 12, "subheading_spacing": 0.4, "subheading_spacing_mobile": 0.4, "subheading_line_height": 1.4, "subheading_line_height_mobile":